@namespace johnvicencio.Views.Shared
@inject RouterController Router
@inject NavigationManager Nav

@if (TotalPages > 1)
{
    <nav aria-label="Pagination">
        <button class="outline secondary" title="First Page" aria-label="First Page" disabled="@(CurrentPage <= 1)" @onclick="() => GoToPage(1)"><span>&laquo;</span></button>
        <button class="outline secondary" title="Previous Page" aria-label="Previous Page" disabled="@(CurrentPage <= 1)" @onclick="() => GoToPage(CurrentPage - 1)"><i class="site-icon" data-lucide="chevron-left"></i></button>
        @foreach (var p in PaginationWindow)
        {
            if (p == CurrentPage)
            {
                <span aria-current="page">@p</span>
            }
            else if (p == -1)
            {
                <span>...</span>
            }
            else
            {
                <a href="@(PageUrl?.Invoke(p) ?? "#")" role="button" class="outline secondary">@p</a>
            }
        }
        <button class="outline secondary" title="Next Page" aria-label="Next Page" disabled="@(CurrentPage >= TotalPages)" @onclick="() => GoToPage(CurrentPage + 1)"><i class="site-icon" data-lucide="chevron-right"></i></button>
        <button class="outline secondary" title="Last Page" aria-label="Last Page" disabled="@(CurrentPage >= TotalPages)" @onclick="() => GoToPage(TotalPages)"><span>&raquo;</span></button>
    </nav>
}

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; } = 1;
    [Parameter] public Func<int, string>? PageUrl { get; set; }
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    private IEnumerable<int> PaginationWindow
    {
        get
        {
            var pages = new List<int>();
            var t = TotalPages;
            var c = CurrentPage;

            pages.Add(1);
            int start = Math.Max(2, c - 1);
            int end = Math.Min(t - 1, c + 1);
            if (start > 2) pages.Add(-1);
            for (int i = start; i <= end; i++) pages.Add(i);
            if (end < t - 1) pages.Add(-1);
            if (t > 1) pages.Add(t);

            return pages;
        }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        if (PageUrl != null)
        {
            Nav.NavigateTo(PageUrl(page));
        }
        else if (OnPageChanged.HasDelegate)
        {
            await OnPageChanged.InvokeAsync(page);
        }
    }
}
