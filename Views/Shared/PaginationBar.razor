@namespace johnvicencio.Views.Shared
@inject RouterController Router
@inject NavigationManager Nav

@if (TotalPages > 1)
{
    <nav class="table-pagination" aria-label="Pagination">
        <button class="outline secondary pagination-btn" title="First Page" aria-label="First Page" disabled="@(CurrentPage <= 1)" @onclick="() => GoToPage(1)"><span style="font-size:0.75rem">&laquo;</span></button>
        <button class="outline secondary pagination-btn" title="Previous Page" aria-label="Previous Page" disabled="@(CurrentPage <= 1)" @onclick="() => GoToPage(CurrentPage - 1)"><i class="site-icon" data-lucide="chevron-left"></i></button>
        @foreach (var p in PaginationWindow)
        {
            if (p == CurrentPage)
            {
                <span class="pagination-btn current" style="font-weight:700;display:inline-flex;align-items:center;justify-content:center">@p</span>
            }
            else if (p == -1)
            {
                <span class="pagination-ellipsis">...</span>
            }
            else
            {
                <a href="@(PageUrl?.Invoke(p) ?? "#")" class="pagination-btn outline secondary" style="text-decoration:none;display:inline-flex;align-items:center;justify-content:center">@p</a>
            }
        }
        <button class="outline secondary pagination-btn" title="Next Page" aria-label="Next Page" disabled="@(CurrentPage >= TotalPages)" @onclick="() => GoToPage(CurrentPage + 1)"><i class="site-icon" data-lucide="chevron-right"></i></button>
        <button class="outline secondary pagination-btn" title="Last Page" aria-label="Last Page" disabled="@(CurrentPage >= TotalPages)" @onclick="() => GoToPage(TotalPages)"><span style="font-size:0.75rem">&raquo;</span></button>
    </nav>
}

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; } = 1;
    [Parameter] public Func<int, string>? PageUrl { get; set; }

    private IEnumerable<int> PaginationWindow
    {
        get
        {
            var pages = new List<int>();
            var t = TotalPages;
            var c = CurrentPage;

            // Always show first page
            pages.Add(1);

            // Window around current page
            int start = Math.Max(2, c - 1);
            int end = Math.Min(t - 1, c + 1);

            if (start > 2) pages.Add(-1); // ellipsis
            for (int i = start; i <= end; i++) pages.Add(i);
            if (end < t - 1) pages.Add(-1); // ellipsis

            // Always show last page
            if (t > 1) pages.Add(t);

            return pages;
        }
    }

    private void GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        if (PageUrl != null)
        {
            Nav.NavigateTo(PageUrl(page));
        }
    }
}
