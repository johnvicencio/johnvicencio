@namespace johnvicencio.Views.Shared
@inject IJSRuntime Js

<div class="table-search">
    <div class="table-search-field">
        <i class="site-icon" data-lucide="search"></i>
        <input type="text" placeholder="@Placeholder" value="@SearchQuery" @oninput="OnInput" aria-label="@Placeholder" autocomplete="off" />
    </div>
    @if (!string.IsNullOrWhiteSpace(SearchQuery))
    {
        <button type="button" class="outline secondary btn-action search-clear" title="Clear search" aria-label="Clear search" @onclick="Clear"><i class="site-icon" data-lucide="x"></i></button>
    }
</div>

@code {
    [Parameter] public string SearchQuery { get; set; } = "";
    [Parameter] public string Placeholder { get; set; } = "Search...";
    [Parameter] public EventCallback<string> SearchQueryChanged { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await LucideInterop.RefreshIconsAsync(Js);
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        await SearchQueryChanged.InvokeAsync(val);
    }

    private async Task Clear()
    {
        await SearchQueryChanged.InvokeAsync("");
    }
}
