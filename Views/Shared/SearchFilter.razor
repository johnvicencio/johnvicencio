@namespace johnvicencio.Views.Shared
@inject IJSRuntime Js

<search role="search">
    <input type="search" name="search" placeholder="@Placeholder" value="@SearchQuery" @oninput="OnInput" aria-label="@Placeholder" autocomplete="off" />
    @if (!string.IsNullOrWhiteSpace(SearchQuery))
    {
        <button type="button" class="outline secondary" title="Clear search" aria-label="Clear search" @onclick="Clear"><i class="site-icon" data-lucide="x"></i></button>
    }
</search>

@code {
    [Parameter] public string SearchQuery { get; set; } = "";
    [Parameter] public string Placeholder { get; set; } = "Search...";
    [Parameter] public EventCallback<string> SearchQueryChanged { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await LucideInterop.RefreshIconsAsync(Js);
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        await SearchQueryChanged.InvokeAsync(val);
    }

    private async Task Clear()
    {
        await SearchQueryChanged.InvokeAsync("");
    }
}
