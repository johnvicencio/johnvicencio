@namespace johnvicencio.Views.Shared
@inject VaultSessionService Session
@inject NavigationManager Nav
@inject IJSRuntime Js

@if (!isReady)
{
    <section>
        <article>
            <p aria-busy="true">Loading...</p>
        </article>
    </section>
}
else if (!Session.IsLoggedIn)
{
    Nav.NavigateTo("/login", replace: true);
}
else
{
    <section>
        <article>
            @if (!string.IsNullOrWhiteSpace(Title) || ToolbarItems is not null)
            {
                <header>
                    @if (!string.IsNullOrWhiteSpace(Title))
                    {
                        <h1>@Title</h1>
                    }
                    @if (ToolbarItems is not null)
                    {
                        <div role="group">
                            @ToolbarItems
                        </div>
                    }
                </header>
            }
            @ChildContent
        </article>
    </section>
}

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? ToolbarItems { get; set; }

    private bool isReady;

    protected override async Task OnInitializedAsync()
    {
        await Session.TryRestoreAsync(Js);
        isReady = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await LucideInterop.RefreshIconsAsync(Js); } catch { }
    }
}
