@namespace johnvicencio.Views.Shared
@inject VaultSessionService Session
@inject NavigationManager Nav
@inject IJSRuntime Js

@if (!isReady)
{
    <section class="login-page">
        <article class="admin-wrap">
            <p class="loading-state">Loading...</p>
        </article>
    </section>
}
else if (!Session.IsLoggedIn)
{
    Nav.NavigateTo("/login", replace: true);
}
else
{
    <section class="login-page">
        <article class="admin-wrap">
            @if (!string.IsNullOrWhiteSpace(Title) || ToolbarItems is not null)
            {
                <div class="table-toolbar">
                    @if (!string.IsNullOrWhiteSpace(Title))
                    {
                        <h2>@Title</h2>
                    }
                    @if (ToolbarItems is not null)
                    {
                        <div class="flex-group-lg">
                            @ToolbarItems
                        </div>
                    }
                </div>
            }
            @ChildContent
        </article>
    </section>
}

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? ToolbarItems { get; set; }

    private bool isReady;

    protected override async Task OnInitializedAsync()
    {
        await Session.TryRestoreAsync(Js);
        isReady = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await Js.InvokeVoidAsync("lucide.createIcons"); } catch { }
    }
}
