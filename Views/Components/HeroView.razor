<section id="@Section.AnchorId" class="hero@(Section.ImageFullWidth ? " hero-full-width" : "")">
    @if (!string.IsNullOrWhiteSpace(Section.ImageUrl))
    {
        <figure>
            <img src="@Section.ImageUrl" alt="@Section.ImageAlt" />
        </figure>
    }
    <SectionHeading Heading="@Section.Heading" HeadingLevel="@HeadingLevel" />
    @if (!string.IsNullOrWhiteSpace(Section.Body))
    {
        <p>@((MarkupString)Section.Body)</p>
    }
    @if (Section.Buttons.Count > 0)
    {
        <div role="group">
            @foreach (var btn in Section.Buttons)
            {
                if (!string.IsNullOrWhiteSpace(btn.Text) && !string.IsNullOrWhiteSpace(btn.Url))
                {
                    <a href="@btn.Url" role="button">@if (!string.IsNullOrWhiteSpace(btn.Icon)) { <i class="site-icon" data-lucide="@btn.Icon"></i> }@btn.Text</a>
                }
            }
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Section.ActionText) && !string.IsNullOrWhiteSpace(Section.ActionUrl))
    {
        <a href="@Section.ActionUrl" role="button">@Section.ActionText</a>
    }
</section>

@code {
    [Parameter]
    public PageSection Section { get; set; } = new();

    [Parameter]
    public int HeadingLevel { get; set; } = 2;
}
