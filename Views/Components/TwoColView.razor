<section id="@Section.AnchorId" class="grid-section">
    <SectionHeading Heading="@Section.Heading" HeadingLevel="@HeadingLevel" />
    <div class="grid grid-col-wrap">
        @for (var ci = 0; ci < Math.Min(Section.Columns.Count, 2); ci++)
        {
            var col = Section.Columns[ci];
            <div class="grid-col">
                <SectionHeading Heading="@col.Title" HeadingLevel="@(HeadingLevel == 1 ? 2 : 3)" />
                @if (!string.IsNullOrWhiteSpace(col.Body))
                {
                    <div>@((MarkupString)col.Body)</div>
                }
                @if (!string.IsNullOrWhiteSpace(col.ActionText) && !string.IsNullOrWhiteSpace(col.ActionUrl))
                {
                    <a href="@col.ActionUrl" role="button" class="outline">
                        @if (!string.IsNullOrWhiteSpace(col.ActionIcon))
                        {
                            <i class="site-icon" data-lucide="@col.ActionIcon"></i>
                        }
                        @col.ActionText
                    </a>
                }
            </div>
        }
    </div>
</section>

@code {
    [Parameter]
    public PageSection Section { get; set; } = new();

    [Parameter]
    public int HeadingLevel { get; set; } = 2;
}
