<section id="@Section.AnchorId" class="grid-section three-col-section">
    <SectionHeading Heading="@Section.Heading" HeadingLevel="@HeadingLevel" />
    <div class="grid">
        @for (var ci = 0; ci < Math.Min(Section.Columns.Count, 3); ci++)
        {
            var col = Section.Columns[ci];
            <div class="grid-col three-col-icon-block">
                @if (!string.IsNullOrWhiteSpace(col.ActionIcon))
                {
                    <div class="three-col-icon"><i class="site-icon" data-lucide="@col.ActionIcon"></i></div>
                }
                <SectionHeading Heading="@col.Title" HeadingLevel="@(HeadingLevel == 1 ? 2 : 3)" />
                @if (!string.IsNullOrWhiteSpace(col.Body))
                {
                    <div class="content-body">@((MarkupString)col.Body)</div>
                }
                @if (!string.IsNullOrWhiteSpace(col.ActionText) && !string.IsNullOrWhiteSpace(col.ActionUrl))
                {
                    <a href="@col.ActionUrl" role="button" class="outline">@col.ActionText</a>
                }
            </div>
        }
    </div>
</section>

@code {
    [Parameter]
    public PageSection Section { get; set; } = new();

    [Parameter]
    public int HeadingLevel { get; set; } = 2;
}
