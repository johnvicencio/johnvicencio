@inject IJSRuntime Js

<div class="rich-editor">
    <div class="rich-toolbar">
        <button type="button" class="outline secondary rich-btn" @onclick='() => Format("bold")' title="Bold" aria-label="Bold"><strong>B</strong></button>
        <button type="button" class="outline secondary rich-btn" @onclick='() => Format("italic")' title="Italic" aria-label="Italic"><em>I</em></button>
        <button type="button" class="outline secondary rich-btn" @onclick='() => Format("underline")' title="Underline" aria-label="Underline"><u>U</u></button>

        <span class="sep"></span>

        <button type="button" class="outline secondary rich-btn-sm" @onclick='() => Format("formatBlock", "h2")' title="Heading 2" aria-label="Heading 2">H2</button>
        <button type="button" class="outline secondary rich-btn-sm" @onclick='() => Format("formatBlock", "h3")' title="Heading 3" aria-label="Heading 3">H3</button>
        <button type="button" class="outline secondary rich-btn-sm" @onclick='() => Format("formatBlock", "p")' title="Paragraph" aria-label="Paragraph">P</button>

        <span class="sep"></span>

        <button type="button" class="outline secondary rich-btn" @onclick='() => Format("insertUnorderedList")' title="Bullet list" aria-label="Bullet list">
            <svg width="12" height="12" viewBox="0 0 12 12"><circle cx="3" cy="3" r="1.2" fill="currentColor"/><line x1="6" y1="3" x2="11" y2="3" stroke="currentColor" stroke-width="1"/><circle cx="3" cy="9" r="1.2" fill="currentColor"/><line x1="6" y1="9" x2="11" y2="9" stroke="currentColor" stroke-width="1"/></svg>
        </button>
        <button type="button" class="outline secondary rich-btn" @onclick='() => Format("insertOrderedList")' title="Ordered list" aria-label="Ordered list">
            <svg width="12" height="12" viewBox="0 0 12 12"><text x="0" y="4" font-size="4" fill="currentColor" font-weight="bold">1.</text><line x1="6" y1="3" x2="11" y2="3" stroke="currentColor" stroke-width="1"/><text x="0" y="9" font-size="4" fill="currentColor" font-weight="bold">2.</text><line x1="6" y1="9" x2="11" y2="9" stroke="currentColor" stroke-width="1"/></svg>
        </button>

        <span class="sep"></span>

        <button type="button" class="outline secondary rich-btn" @onclick='() => Format("createLink")' title="Insert link" aria-label="Insert link">Link</button>

        <span class="sep-grow"></span>

        <button type="button" class="outline secondary rich-btn-sm" @onclick="ToggleSource" aria-label="Toggle source view">@(showingSource ? "WYSIWYG" : "Source")</button>
    </div>

    <div id="@editorId" contenteditable="@(!showingSource)" class="rich-editor-body"
         style="min-height:@(MinHeight)px;@(showingSource ? "display:none;" : "")"
         @oninput="OnWysiwygInput">
    </div>

    <textarea id="@textareaId"
              style="display:@(showingSource ? "block" : "none");min-height:@(MinHeight)px"
              class="rich-editor-source"
              @bind="Value" @bind:after="OnSourceChanged">
    </textarea>
</div>

@code {
    private string editorId = "re_" + Guid.NewGuid().ToString("N")[..6];
    private string textareaId = "re_ta_" + Guid.NewGuid().ToString("N")[..6];
    private bool showingSource;
    private bool rendered;

    private string _value = "";

    [Parameter]
    public string Value { get; set; } = "";

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public int MinHeight { get; set; } = 300;

    [Parameter]
    public string Placeholder { get; set; } = "Write your content...";

    private async Task Format(string command, string? value = null)
    {
        if (showingSource) return;
        await Js.InvokeVoidAsync("richEditor.format", editorId, command, value);
        await SyncHtml();
    }

    private async Task SyncHtml()
    {
        if (showingSource) return;
        _value = await Js.InvokeAsync<string>("richEditor.getHtml", editorId);
        await ValueChanged.InvokeAsync(_value);
    }

    private async Task OnWysiwygInput()
    {
        await SyncHtml();
    }

    private async Task ToggleSource()
    {
        var nowShowingSource = await Js.InvokeAsync<bool>("richEditor.toggleSource", editorId, textareaId);
        showingSource = nowShowingSource;
    }

    private async Task OnSourceChanged()
    {
        _value = Value;
        await ValueChanged.InvokeAsync(_value);
        if (showingSource)
        {
            await Js.InvokeVoidAsync("richEditor.setHtml", editorId, _value);
        }
    }

    protected override void OnParametersSet()
    {
        if (_value != Value)
        {
            _value = Value ?? "";
            if (rendered && !showingSource)
                _ = Js.InvokeVoidAsync("richEditor.setHtml", editorId, _value);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            rendered = true;
            await Js.InvokeVoidAsync("richEditor.init", editorId);
            await Js.InvokeVoidAsync("richEditor.setHtml", editorId, Value);
        }
    }
}
