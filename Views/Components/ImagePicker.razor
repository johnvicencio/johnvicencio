@inject IJSRuntime Js
@inject ImageAssetController Images

<dialog @ref="dialogRef" class="picker-dialog" aria-labelledby="image-picker-title" @oncancel="Cancel" @oncancel:preventDefault="true">
    <article>
        <header>
            <h3 id="image-picker-title">Select Image</h3>
            <button type="button" class="outline secondary" title="Close" aria-label="Close" @onclick="Cancel"><i class="site-icon" data-lucide="x"></i></button>
        </header>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <p role="alert" data-variant="danger">@errorMessage</p>
        }
        else if (loading)
        {
            <p><small>Loading images...</small></p>
        }
        else
        {
            <label>Folder
                <select @bind="selectedFolder">
                    <option value="">All images</option>
                    @foreach (var folder in folders)
                    {
                        <option value="@folder">@folder</option>
                    }
                </select>
            </label>

            <div class="grid picker-tiles">
                @foreach (var image in VisibleImages)
                {
                    <button type="button" class="outline" aria-pressed="@(image.Url == selectedPath)" @onclick="() => Select(image.Url)">
                        <img src="@image.Url" alt="@image.FileName" />
                        <small>@image.Url</small>
                    </button>
                }
            </div>

            <label>Selected Relative Path
                <input readonly value="@selectedPath" />
            </label>

            <footer role="group">
                    <button type="button" class="outline secondary" disabled="@string.IsNullOrWhiteSpace(selectedPath)" @onclick="ClearSelection"><i class="site-icon" data-lucide="image-off"></i>Clear Image</button>
                    <button type="button" class="outline secondary" @onclick="Cancel">Cancel</button>
                    <button type="button" disabled="@string.IsNullOrWhiteSpace(selectedPath)" @onclick="Confirm"><i class="site-icon" data-lucide="check"></i>OK</button>
            </footer>
        }
    </article>
</dialog>

@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public string Value { get; set; } = "";

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private ElementReference dialogRef;
    private bool lastOpen;
    private bool loading;
    private string errorMessage = "";
    private string selectedFolder = "";
    private string selectedPath = "";
    private List<ImageAsset> imageList = [];
    private List<string> folders = [];

    private List<ImageAsset> VisibleImages => string.IsNullOrWhiteSpace(selectedFolder)
        ? imageList
        : imageList.Where(image => image.Folder == selectedFolder).ToList();

    protected override async Task OnParametersSetAsync()
    {
        selectedPath = Value;
        if (Open && imageList.Count == 0 && !loading)
        {
            await LoadImagesAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open == lastOpen) return;
        lastOpen = Open;
        if (Open)
            await DialogInterop.OpenAsync(Js, dialogRef);
        else
            await DialogInterop.CloseAsync(Js, dialogRef);
    }

    private async Task LoadImagesAsync()
    {
        loading = true;
        errorMessage = "";
        try
        {
            imageList = await Images.GetImagesAsync();
            folders = imageList
                .Select(image => image.Folder)
                .Where(folder => !string.IsNullOrWhiteSpace(folder))
                .Distinct()
                .OrderBy(folder => folder)
                .ToList();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void Select(string path)
    {
        selectedPath = path;
    }

    private async Task Confirm()
    {
        await ValueChanged.InvokeAsync(selectedPath);
        await OnClose.InvokeAsync();
    }

    private async Task ClearSelection()
    {
        selectedPath = "";
        await ValueChanged.InvokeAsync(selectedPath);
        await OnClose.InvokeAsync();
    }

    private async Task Cancel()
    {
        await OnClose.InvokeAsync();
    }
}
