@inject IJSRuntime Js

@if (Open)
{
    <div class="icon-picker-backdrop" @onclick="Close">
        <div class="icon-picker-modal" @onclick:stopPropagation>
            <div class="table-toolbar">
                <h4 class="picker-heading">Select Icon</h4>
                <button class="outline secondary picker-close" @onclick="Close"><i class="site-icon" data-lucide="x"></i></button>
            </div>

            <input type="search" @bind="search" @bind:event="oninput" placeholder="Search icons..." class="picker-search-gap" />

            @if (icons.Count == 0)
            {
                <p class="pagination-info picker-info">Loading icons...</p>
            }
            else
            {
                var filtered = string.IsNullOrWhiteSpace(search)
                    ? icons
                    : icons.Where(i => i.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();

                @if (filtered.Count == 0)
                {
                    <p class="pagination-info picker-info">No icons matching "@search".</p>
                }
                else
                {
                    <div class="icon-picker-grid">
                        @foreach (var icon in filtered)
                        {
                            var iName = icon;
                            <button type="button" class="icon-picker-tile @(iName == Value ? "selected" : "")" title="@iName" @onclick="() => Select(iName)">
                                <i class="site-icon icon-lg" data-lucide="@iName"></i>
                                <span>@iName</span>
                            </button>
                        }
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string search = "";
    private List<string> icons = [];

    protected override async Task OnInitializedAsync()
    {
        icons = await Js.InvokeAsync<List<string>>("getLucideIcons");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open)
            await Js.InvokeVoidAsync("lucide.createIcons");
    }

    private void Close()
    {
        OnClose.InvokeAsync();
    }

    private async Task Select(string icon)
    {
        await ValueChanged.InvokeAsync(icon);
        await OnClose.InvokeAsync();
    }
}
