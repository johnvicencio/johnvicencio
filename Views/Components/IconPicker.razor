@inject IJSRuntime Js

<dialog @ref="dialogRef" class="picker-dialog picker-dialog-icon" aria-labelledby="icon-picker-title" @oncancel="Close" @oncancel:preventDefault="true">
    <article>
        <header>
            <h4 id="icon-picker-title">Select Icon</h4>
            <button type="button" class="outline secondary" aria-label="Close" @onclick="Close"><i class="site-icon" data-lucide="x"></i></button>
        </header>

        <SearchFilter SearchQuery="@search" SearchQueryChanged="HandleSearch" Placeholder="Search icons..." />

        @if (icons.Count == 0)
        {
            <p><small>Loading icons...</small></p>
        }
        else
        {
            var filtered = string.IsNullOrWhiteSpace(search)
                ? icons
                : icons.Where(i => i.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();

            @if (filtered.Count == 0)
            {
                <p><small>No icons matching "@search".</small></p>
            }
            else
            {
                <div class="grid picker-tiles">
                    @foreach (var icon in filtered)
                    {
                        var iName = icon;
                        <button type="button" class="outline" aria-pressed="@(iName == Value)" title="@iName" @onclick="() => Select(iName)">
                            <i class="site-icon" data-lucide="@iName"></i>
                            <small>@iName</small>
                        </button>
                    }
                </div>
            }
        }
    </article>
</dialog>

@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private ElementReference dialogRef;
    private bool lastOpen;
    private string search = "";
    private List<string> icons = [];

    protected override async Task OnInitializedAsync()
    {
        icons = await Js.InvokeAsync<List<string>>("getLucideIcons");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open != lastOpen)
        {
            lastOpen = Open;
            if (Open)
                await DialogInterop.OpenAsync(Js, dialogRef);
            else
                await DialogInterop.CloseAsync(Js, dialogRef);
        }

        if (Open)
            await LucideInterop.RefreshIconsAsync(Js);
    }

    private void HandleSearch(string val) => search = val;

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task Select(string icon)
    {
        await ValueChanged.InvokeAsync(icon);
        await OnClose.InvokeAsync();
    }
}
