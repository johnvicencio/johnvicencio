@inject IJSRuntime Js

<section id="@Section.AnchorId" class="card-collection @(IsGridCard ? "grid-card-section" : "row-card-section")">
    <SectionHeading Heading="@Section.Heading" HeadingLevel="@HeadingLevel" Icon="@Section.Icon" />
    @if (Section.Columns.Count > 0)
    {
        @if (IsGridCard)
        {
            <div class="grid">
                @foreach (var item in Section.Columns)
                {
                    <article>
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <figure>
                                <a href="@(string.IsNullOrWhiteSpace(item.ImageLink) ? item.ActionUrl : item.ImageLink)" target="@LinkTarget(item.ImageLinkNewTab)" rel="@LinkRel(item.ImageLinkNewTab)">
                                    <img src="@item.ImageUrl" alt="@item.ImageAlt" />
                                </a>
                                @if (IsExpanded(item))
                                {
                                    <div class="card-description-overlay">@((MarkupString)item.Body)</div>
                                }
                            </figure>
                        }
                        <header>
                            <h3>@item.Title</h3>
                            @if (!string.IsNullOrWhiteSpace(item.Body))
                            {
                                <button type="button"
                                        class="outline secondary"
                                        @onclick="() => ToggleCard(item)"
                                        aria-label="@(IsExpanded(item) ? "Close" : "Open") @item.Title description"
                                        aria-expanded="@IsExpanded(item)">
                                    <i class="site-icon" data-lucide="@(IsExpanded(item) ? "x" : "ellipsis")"></i>
                                </button>
                            }
                        </header>
                        @if (!string.IsNullOrWhiteSpace(item.ActionText) && !string.IsNullOrWhiteSpace(item.ActionUrl))
                        {
                            <footer>
                                <a href="@item.ActionUrl" role="button" class="outline" target="@LinkTarget(item.ActionNewTab)" rel="@LinkRel(item.ActionNewTab)">@item.ActionText</a>
                            </footer>
                        }
                    </article>
                }
            </div>
        }
        else
        {
            <div class="row-card-list">
            @foreach (var item in Section.Columns)
            {
                <article>
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <figure>
                            @if (!string.IsNullOrWhiteSpace(item.ImageLink))
                            {
                                <a href="@item.ImageLink" target="@LinkTarget(item.ImageLinkNewTab)" rel="@LinkRel(item.ImageLinkNewTab)">
                                    <img src="@item.ImageUrl" alt="@item.ImageAlt" />
                                </a>
                            }
                            else
                            {
                                <img src="@item.ImageUrl" alt="@item.ImageAlt" />
                            }
                        </figure>
                    }
                    <div>
                        @if (!string.IsNullOrWhiteSpace(item.Title))
                        {
                            <h3>@item.Title</h3>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                        {
                            <small>@((MarkupString)item.Subtitle)</small>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Body))
                        {
                            <div>@((MarkupString)item.Body)</div>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(item.ActionUrl))
                    {
                        <footer>
                            <a href="@item.ActionUrl" target="@LinkTarget(item.ActionNewTab)" rel="@LinkRel(item.ActionNewTab)" aria-label="@($"Open {item.Title}")">
                                <i class="site-icon" data-lucide="@(string.IsNullOrWhiteSpace(item.ActionIcon) ? "external-link" : item.ActionIcon)"></i>
                            </a>
                        </footer>
                    }
                </article>
            }
            </div>
        }
    }
    else if (!string.IsNullOrWhiteSpace(Section.Body))
    {
        <p>@((MarkupString)Section.Body)</p>
    }
</section>

@code {
    [Parameter]
    public PageSection Section { get; set; } = new();

    [Parameter]
    public int HeadingLevel { get; set; } = 2;

    private bool IsGridCard => Section.Type is "grid-card" or "portfolio";

    private readonly HashSet<SectionColumn> expandedCards = new();

    private bool IsExpanded(SectionColumn item) => expandedCards.Contains(item);

    private void ToggleCard(SectionColumn item)
    {
        if (!expandedCards.Remove(item))
            expandedCards.Add(item);
    }

    private static string? LinkTarget(bool newTab) => newTab ? "_blank" : null;

    private static string? LinkRel(bool newTab) => newTab ? "noopener noreferrer" : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await LucideInterop.RefreshIconsAsync(Js);
    }
}
