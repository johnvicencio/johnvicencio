@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime Js
@inject VaultSessionService Session
@inject NavigationManager Nav
@inject PageController Pages
@inject SiteController Site

<div class="site-shell">
    <header class="site-header">
        <div class="container">
            <nav aria-label="Main navigation">
                <ul>
                    <li><strong><a href="/" aria-current="@NavAriaCurrent("/")"><img src="/images/johnvicencio-brand.png" alt="johnvicencio" /></a></strong></li>
                </ul>
                <button type="button" class="outline secondary" aria-label="Toggle navigation menu" aria-expanded="@mobileMenuOpen" @onclick="ToggleMobileMenu">
                    <i class="site-icon" data-lucide="@(mobileMenuOpen ? "x" : "menu")"></i>
                </button>
                <ul>
                    @foreach (var link in allNavLinks)
                    {
                        <li><a href="@link.Url" aria-current="@NavAriaCurrent(link.Url)"><i class="site-icon" data-lucide="@link.Icon"></i>@link.Label</a></li>
                    }
                    @if (Session.IsLoggedIn)
                    {
                        <li><a href="/admin" aria-current="@NavAriaCurrent("/admin")"><i class="site-icon" data-lucide="layout-dashboard"></i>Dashboard</a></li>
                        <li><button type="button" @onclick="LogOut"><i class="site-icon" data-lucide="log-out"></i>Logout</button></li>
                    }
                </ul>
            </nav>
            @if (mobileMenuOpen)
            {
                <nav aria-label="Mobile navigation">
                    <ul>
                        @foreach (var link in allNavLinks)
                        {
                            <li><a href="@link.Url" aria-current="@NavAriaCurrent(link.Url)" @onclick="CloseMobileMenu"><i class="site-icon" data-lucide="@link.Icon"></i>@link.Label</a></li>
                        }
                        @if (Session.IsLoggedIn)
                        {
                            <li><a href="/admin" aria-current="@NavAriaCurrent("/admin")" @onclick="CloseMobileMenu"><i class="site-icon" data-lucide="layout-dashboard"></i>Dashboard</a></li>
                            <li><button type="button" @onclick="LogOut"><i class="site-icon" data-lucide="log-out"></i>Logout</button></li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </header>

    <main class="site-main">
        <div class="container">
            @if (maintenanceMode && !Session.IsLoggedIn)
            {
                <section class="maintenance-block">
                    <h1>Under Maintenance</h1>
                    <p>This site is currently undergoing scheduled maintenance. Please check back soon.</p>
                </section>
            }
            else
            {
                @Body
            }
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="grid">
                <div>
                    <h4>@footerAboutHeader</h4>
                    <div>@((MarkupString)footerAbout)</div>
                </div>
                <div>
                    <h4>Sections</h4>
                    <div class="footer-section-columns">
                        <ul>
                            @foreach (var sec in footerLeftSectionLinks)
                            {
                                <li><a href="@sec.Url"><i class="site-icon" data-lucide="@sec.Icon"></i>@sec.Label</a></li>
                            }
                        </ul>
                        <ul>
                            @foreach (var sec in footerRightSectionLinks)
                            {
                                <li><a href="@sec.Url"><i class="site-icon" data-lucide="@sec.Icon"></i>@sec.Label</a></li>
                            }
                        </ul>
                    </div>
                </div>
                <div>
                    <h4>Connect</h4>
                    <ul>
                        @foreach (var connect in footerConnects)
                        {
                            <li><a href="@connect.Url" target="_blank" rel="noopener noreferrer"><i class="site-icon" data-lucide="@connect.Icon"></i>@connect.Platform</a></li>
                        }
                    </ul>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                <small>&copy; @DateTime.Now.Year John Vicencio. Made with <span class="footer-heart">&hearts;</span> in the USA.</small>
            </div>
        </div>
    </footer>
</div>

@code {
    private List<CustomNavLink> allNavLinks = [];
    private List<CustomNavLink> footerSectionLinks = [];
    private List<CustomNavLink> footerLeftSectionLinks = [];
    private List<CustomNavLink> footerRightSectionLinks = [];
    private string footerAboutHeader = "";
    private string footerAbout = "";
    private List<FooterConnect> footerConnects = [];
    private bool mobileMenuOpen;
    private bool maintenanceMode;
    private string? currentFragment;
    private DotNetObjectReference<MainLayout>? dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        await Session.TryRestoreAsync(Js);

        if (!Session.IsLoggedIn)
        {
            var path = new Uri(Nav.Uri).AbsolutePath;
            if (!path.Equals("/login", StringComparison.OrdinalIgnoreCase))
                Session.ReturnUrl = Nav.Uri;
        }
        else
        {
            Session.ReturnUrl = null;
        }

        currentFragment = NormalizeFragment(new Uri(Nav.Uri).Fragment);
        Nav.LocationChanged += OnLocationChanged;
        Pages.PagesChanged += OnPagesChanged;
        Site.SettingsChanged += OnSettingsChanged;
        await LoadNavAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentFragment = NormalizeFragment(new Uri(e.Location).Fragment);
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnBrowserLocationChanged(string hash)
    {
        currentFragment = NormalizeFragment(hash);
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task LogOut()
    {
        mobileMenuOpen = false;
        await Session.SignOutAsync(Js);
        Nav.NavigateTo("/", replace: true);
    }

    private void ToggleMobileMenu()
    {
        mobileMenuOpen = !mobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        mobileMenuOpen = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            try { await Js.InvokeVoidAsync("registerNavLocationListener", dotNetRef); } catch { }
        }

        try { await LucideInterop.RefreshIconsAsync(Js); } catch { }
    }

    private async Task LoadNavAsync()
    {
        var settings = await Site.GetSettingsAsync();
        maintenanceMode = settings.MaintenanceMode;
        var saved = settings.NavLinks ?? [];

        if (saved.Count > 0)
        {
            allNavLinks = saved
                .Where(n => !string.IsNullOrWhiteSpace(n.Label) && !string.IsNullOrWhiteSpace(n.Url))
                .Where(n => !IsLegalUrl(n.Url))
                .Select(n => new CustomNavLink
                {
                    Label = n.Label,
                    Url = n.Url,
                    Icon = string.IsNullOrWhiteSpace(n.Icon) ? "link" : n.Icon
                })
                .ToList();
        }
        else
        {
            var pages = await Pages.GetPagesAsync();
            allNavLinks = pages
                .Where(p => !p.Slug.Equals("home", StringComparison.OrdinalIgnoreCase) && !IsLegalSlug(p.Slug))
                .OrderBy(p => p.SortOrder)
                .ThenBy(p => p.Title)
                .Select(p => new CustomNavLink
                {
                    Label = p.Title,
                    Url = $"/{p.Slug}",
                    Icon = p.Slug.ToLowerInvariant() switch
                    {
                        "about" => "user",
                        "blog" => "book-open",
                        "contact" => "mail",
                        _ => "file-text",
                    }
                })
                .ToList();
        }

        footerSectionLinks = allNavLinks
            .Concat([
                new CustomNavLink { Label = "Terms & Conditions", Url = "/terms-and-conditions", Icon = "file-check" },
                new CustomNavLink { Label = "Privacy", Url = "/privacy-policy", Icon = "fingerprint" },
            ])
            .ToList();
        footerLeftSectionLinks = footerSectionLinks
            .Where(link => IsFooterLeftSection(link.Label))
            .ToList();
        footerRightSectionLinks = footerSectionLinks
            .Where(link => IsFooterRightSection(link.Label))
            .ToList();

        footerAboutHeader = string.IsNullOrWhiteSpace(settings.FooterAboutHeader)
            ? "About John Vicencio"
            : settings.FooterAboutHeader;
        footerAbout = string.IsNullOrWhiteSpace(settings.FooterAbout)
            ? "John Serrano Vicencio was born in Manila, Philippines, and grew up in San Diego, California. His passion is to look at reality with depth and clarity while keeping an open mind. He focuses on C# and the .NET ecosystem, blending philosophy with software craftsmanship."
            : settings.FooterAbout;
        footerConnects = (settings.FooterConnects ?? [])
            .Where(c => !string.IsNullOrWhiteSpace(c.Platform) && !string.IsNullOrWhiteSpace(c.Url))
            .Select(c => new FooterConnect
            {
                Platform = c.Platform,
                Url = c.Url,
                Icon = string.IsNullOrWhiteSpace(c.Icon) ? "link" : c.Icon,
            })
            .ToList();
    }

    private static bool IsLegalSlug(string slug) =>
        slug.Equals("terms-and-conditions", StringComparison.OrdinalIgnoreCase) ||
        slug.Equals("privacy-policy", StringComparison.OrdinalIgnoreCase);

    private static bool IsFooterLeftSection(string label) =>
        label.Equals("About", StringComparison.OrdinalIgnoreCase) ||
        label.Equals("Experience", StringComparison.OrdinalIgnoreCase) ||
        label.Equals("Portfolio", StringComparison.OrdinalIgnoreCase) ||
        label.Equals("Blog", StringComparison.OrdinalIgnoreCase);

    private static bool IsFooterRightSection(string label) =>
        label.Equals("Contact", StringComparison.OrdinalIgnoreCase) ||
        label.Equals("Terms & Conditions", StringComparison.OrdinalIgnoreCase) ||
        label.Equals("Privacy", StringComparison.OrdinalIgnoreCase);

    private static bool IsLegalUrl(string url)
    {
        var path = url.Split('#', '?')[0].TrimEnd('/');
        return path.Equals("/terms-and-conditions", StringComparison.OrdinalIgnoreCase) ||
            path.Equals("/privacy-policy", StringComparison.OrdinalIgnoreCase);
    }

    private string? NavAriaCurrent(string url)
    {
        var currentUri = new Uri(Nav.Uri);
        var currentPath = currentUri.AbsolutePath.TrimEnd('/');
        if (string.IsNullOrEmpty(currentPath))
            currentPath = "/";

        var activeFragment = currentFragment ?? NormalizeFragment(currentUri.Fragment);
        var (linkPath, linkFragment) = ParseNavUrl(url);

        if (linkPath.Equals("/admin", StringComparison.OrdinalIgnoreCase))
            return currentPath.StartsWith("/admin", StringComparison.OrdinalIgnoreCase) ? "page" : null;

        if (linkFragment is not null)
            return currentPath == "/" && activeFragment == linkFragment ? "page" : null;

        if (linkPath.Equals("/", StringComparison.OrdinalIgnoreCase))
            return currentPath == "/" && activeFragment is null ? "page" : null;

        return currentPath.Equals(linkPath, StringComparison.OrdinalIgnoreCase) ? "page" : null;
    }

    private static string? NormalizeFragment(string fragment)
    {
        if (string.IsNullOrEmpty(fragment))
            return null;

        var normalized = fragment.TrimStart('#');
        return string.IsNullOrEmpty(normalized) ? null : normalized.ToLowerInvariant();
    }

    private static (string Path, string? Fragment) ParseNavUrl(string url)
    {
        var hashIndex = url.IndexOf('#');
        var pathPart = hashIndex >= 0 ? url[..hashIndex] : url.Split('?')[0];
        var linkFragment = hashIndex >= 0 ? NormalizeFragment(url[hashIndex..]) : null;

        var linkPath = pathPart.TrimEnd('/');
        if (string.IsNullOrEmpty(linkPath))
            linkPath = "/";

        return (linkPath, linkFragment);
    }

    private void OnPagesChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadNavAsync();
            StateHasChanged();
            try { await LucideInterop.RefreshIconsAsync(Js); } catch { }
        });
    }

    private async void OnSettingsChanged()
    {
        await LoadNavAsync();
        StateHasChanged();
        try { await LucideInterop.RefreshIconsAsync(Js); } catch { }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        dotNetRef?.Dispose();
        try { _ = Js.InvokeVoidAsync("unregisterNavLocationListener"); } catch { }
        Pages.PagesChanged -= OnPagesChanged;
        Site.SettingsChanged -= OnSettingsChanged;
    }
}
