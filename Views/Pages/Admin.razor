@page "/admin"
@inject NavigationManager Nav
@inject PageController Pages
@inject BlogController Blog
@inject ContactMessageController Messages
@inject DataStore Store
@inject LogService Log

<PageTitle>Admin</PageTitle>

<AdminPageLayout Title="Admin Dashboard">

@if (loading)
{
    <p aria-busy="true">Loading...</p>
}
else
{
    <div class="grid">
        <article>
            <header>
                <h3>Pages</h3>
                <small>@totalPages page(s) · @totalSections section(s)</small>
            </header>
            <footer>
                <button class="outline" title="Manage Pages" aria-label="Manage Pages" @onclick='() => Nav.NavigateTo("/admin/pages")'><i class="site-icon" data-lucide="sliders-horizontal"></i></button>
            </footer>
        </article>

        <article>
            <header>
                <h3>Blog</h3>
                <small>@totalPosts post(s)</small>
            </header>
            <footer>
                <button class="outline" title="Manage Blog" aria-label="Manage Blog" @onclick='() => Nav.NavigateTo("/admin/blog")'><i class="site-icon" data-lucide="book-open"></i></button>
            </footer>
        </article>

        <article>
            <header>
                <h3>Messages</h3>
                @if (!string.IsNullOrWhiteSpace(messageError))
                {
                    <small><del>Counts unavailable</del></small>
                }
                else
                {
                    <small>@totalMessages total · @newMessages new</small>
                }
            </header>
            <footer>
                <button class="outline" title="Manage Messages" aria-label="Manage Messages" @onclick='() => Nav.NavigateTo("/admin/messages")'><i class="site-icon" data-lucide="inbox"></i></button>
            </footer>
        </article>
    </div>
    <div class="grid">
        <article>
            <header>
                <h3>Images</h3>
                <small>Upload and reuse media</small>
            </header>
            <footer>
                <button class="outline" title="Manage Images" aria-label="Manage Images" @onclick='() => Nav.NavigateTo("/admin/images")'><i class="site-icon" data-lucide="image"></i></button>
            </footer>
        </article>

        <article>
            <header>
                <h3>Logs</h3>
                @if (!string.IsNullOrWhiteSpace(logError))
                {
                    <small><del>Counts unavailable</del></small>
                }
                else
                {
                    <small>@totalLogs total · @totalErrors error(s)</small>
                }
            </header>
            <footer>
                <button class="outline" title="View Logs" aria-label="View Logs" @onclick='() => Nav.NavigateTo("/admin/logs")'><i class="site-icon" data-lucide="scroll-text"></i></button>
            </footer>
        </article>

        <article>
            <header>
                <h3>Partials</h3>
                <small>Nav links, footer, connect</small>
            </header>
            <footer>
                <button class="outline" title="Manage Partials" aria-label="Manage Partials" @onclick='() => Nav.NavigateTo("/admin/partials")'><i class="site-icon" data-lucide="puzzle"></i></button>
            </footer>
        </article>
    </div>
    <div class="grid">
    
        <article>
            <header>
                <h3>Settings</h3>
            </header>
            <p>
                <a href="https://app.netlify.com/projects/johnvicencio/deploys" target="_blank" rel="noopener noreferrer">
                    <img src="https://api.netlify.com/api/v1/badges/a990b9f4-0b90-4325-9054-5ab13fe29c75/deploy-status" alt="Netlify Deploy Status" />
                </a>
            </p>
            <footer>
                <button class="outline" title="Manage Settings" aria-label="Manage Settings" @onclick='() => Nav.NavigateTo("/admin/settings")'><i class="site-icon" data-lucide="settings"></i></button>
            </footer>
        </article>

    </div>
}
</AdminPageLayout>

@code {
    private bool loading = true;
    private int totalPages;
    private int totalSections;
    private int totalPosts;
    private int totalMessages;
    private int newMessages;
    private int totalLogs;
    private int totalErrors;
    private string messageError = "";
    private string logError = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var pageList = await Pages.GetPagesAsync();
            var postList = await Blog.GetPostsAsync();
            totalPages = pageList.Count;
            totalSections = pageList.Sum(p => p.Sections.Count);
            totalPosts = postList.Count;

            try
            {
                var messageList = await Messages.GetMessagesAsync();
                totalMessages = messageList.Count;
                newMessages = messageList.Count(m => !m.IsRead);
            }
            catch (Exception ex)
            {
                messageError = ex.Message;
            }

            try
            {
                var logs = await Log.GetLogsAsync();
                totalLogs = logs.Count;
                totalErrors = logs.Count(l => l.Level.Equals("error", StringComparison.OrdinalIgnoreCase));
            }
            catch (Exception ex)
            {
                logError = ex.Message;
            }
        }
        finally
        {
            loading = false;
        }
    }

}
