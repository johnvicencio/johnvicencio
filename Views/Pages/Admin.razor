@page "/admin"
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject PageController Pages
@inject BlogController Blog
@inject ContactMessageController Messages
@inject DataStore Store

<PageTitle>Admin</PageTitle>

<AdminPageLayout>

@if (loading)
{
    <p class="loading-state">Loading...</p>
}
else
{
    <h1>Admin Dashboard</h1>

    <div class="card-grid">

        <article class="admin-card">
            <header>
                <h3>Pages</h3>
                <p class="muted-text">@totalPages page(s)</p>
                <p class="muted-text">@totalSections section(s)</p>
            </header>
            <footer>
                <button class="outline btn-block" title="Manage Pages" aria-label="Manage Pages" @onclick='() => Nav.NavigateTo("/admin/pages")'><i class="site-icon" data-lucide="sliders-horizontal"></i></button>
            </footer>
        </article>

        <article class="admin-card">
            <header>
                <h3>Blog</h3>
                <p class="muted-text">@totalPosts post(s)</p>
            </header>
            <footer>
                <button class="outline btn-block" title="Manage Blog" aria-label="Manage Blog" @onclick='() => Nav.NavigateTo("/admin/blog")'><i class="site-icon" data-lucide="book-open"></i></button>
            </footer>
        </article>

        <article class="admin-card">
            <header>
                <h3>Messages</h3>
                @if (!string.IsNullOrWhiteSpace(messageError))
                {
                    <p class="text-danger">Counts unavailable</p>
                }
                else
                {
                    <p class="muted-text">@totalMessages total</p>
                    <p class="muted-text">@newMessages new</p>
                }
            </header>
            <footer>
                <button class="outline btn-block" title="Manage Messages" aria-label="Manage Messages" @onclick='() => Nav.NavigateTo("/admin/messages")'><i class="site-icon" data-lucide="inbox"></i></button>
            </footer>
        </article>

        <article class="admin-card">
            <header>
                <h3>Images</h3>
                <p class="muted-text">Upload and reuse media</p>
            </header>
            <footer>
                <button class="outline btn-block" title="Manage Images" aria-label="Manage Images" @onclick='() => Nav.NavigateTo("/admin/images")'><i class="site-icon" data-lucide="image"></i></button>
            </footer>
        </article>

        <article class="admin-card">
            <header>
                <h3>Partials</h3>
                <p class="muted-text">Nav links, footer, connect</p>
            </header>
            <footer>
                <button class="outline btn-block" title="Manage Partials" aria-label="Manage Partials" @onclick='() => Nav.NavigateTo("/admin/partials")'><i class="site-icon" data-lucide="puzzle"></i></button>
            </footer>
        </article>

        <article class="admin-card">
            <header>
                <h3>Settings</h3>
                <p>
                    <a href="https://app.netlify.com/projects/johnvicencio/deploys" target="_blank" rel="noopener noreferrer">
                        <img src="https://api.netlify.com/api/v1/badges/a990b9f4-0b90-4325-9054-5ab13fe29c75/deploy-status" alt="Netlify Deploy Status" />
                    </a>
                </p>
            </header>
            <footer>
                <button class="outline btn-block" title="Manage Settings" aria-label="Manage Settings" @onclick='() => Nav.NavigateTo("/admin/settings")'><i class="site-icon" data-lucide="settings"></i></button>
            </footer>
        </article>

    </div>
}
</AdminPageLayout>

@code {
    private bool loading = true;
    private int totalPages;
    private int totalSections;
    private int totalPosts;
    private int totalMessages;
    private int newMessages;
    private string messageError = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var pageList = await Pages.GetPagesAsync();
            var postList = await Blog.GetPostsAsync();
            totalPages = pageList.Count;
            totalSections = pageList.Sum(p => p.Sections.Count);
            totalPosts = postList.Count;

            try
            {
                var messageList = await Messages.GetMessagesAsync();
                totalMessages = messageList.Count;
                newMessages = messageList.Count(m => !m.IsRead);
            }
            catch (Exception ex)
            {
                messageError = ex.Message;
            }
        }
        finally
        {
            loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await Js.InvokeVoidAsync("lucide.createIcons");
    }
}
