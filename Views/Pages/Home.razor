@page "/"
@page "/home"
@inject PageController Pages
@inject NavigationManager Nav
@inject SiteController Site
@inject IJSRuntime Js

<PageTitle>John Vicencio — Web Technology Craftsmanship</PageTitle>

@if (loading)
{
    <p>Loading home page...</p>
}
else if (page is null)
{
    <p>Home page content was not found.</p>
}
else
{
    var hasPageH1 = false;
    @foreach (var section in page.Sections)
    {
        var headingLevel = !hasPageH1 && !string.IsNullOrWhiteSpace(section.Heading) ? 1 : 2;
        if (headingLevel == 1)
        {
            hasPageH1 = true;
        }

        if (section.Type.Equals("hero", StringComparison.OrdinalIgnoreCase))
        {
            <HeroView Section="section" HeadingLevel="headingLevel" />
        }
        else if (section.Type.Equals("2-col", StringComparison.OrdinalIgnoreCase))
        {
            <TwoColView Section="section" HeadingLevel="headingLevel" />
        }
        else if (section.Type.Equals("3-col", StringComparison.OrdinalIgnoreCase))
        {
            <ThreeColView Section="section" HeadingLevel="headingLevel" />
        }
        else if (section.Type.Equals("cards", StringComparison.OrdinalIgnoreCase) || section.Type.Equals("cardcollection", StringComparison.OrdinalIgnoreCase) || section.Type.Equals("row-card", StringComparison.OrdinalIgnoreCase) || section.Type.Equals("grid-card", StringComparison.OrdinalIgnoreCase) || section.Type.Equals("portfolio", StringComparison.OrdinalIgnoreCase))
        {
            <CardCollectionView Section="section" HeadingLevel="headingLevel" />
        }
        else if (section.Type.Equals("contact", StringComparison.OrdinalIgnoreCase))
        {
            <ContactView Section="section" HeadingLevel="headingLevel" />
        }
        else
        {
            <ContentView Section="section" HeadingLevel="headingLevel" />
        }
    }
}

@code {
    private Page? page;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (new Uri(Nav.Uri).AbsolutePath.Equals("/home", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        page = await Pages.GetPageAsync("home");
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Js.InvokeVoidAsync("setPageMeta", new
            {
                title = "John Vicencio — Web Technology Craftsmanship",
                description = "John Vicencio — Web technology craftsmanship. C# / .NET developer, philosopher, and lifelong learner based in San Diego.",
                image = "https://johnvicencio.com/images/johnvicencio-brand.png"
            });
        }
        await Js.InvokeVoidAsync("lucide.createIcons");
    }
}
