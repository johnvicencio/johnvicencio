@page "/admin/messages/{MessageId}"
@inject NavigationManager Nav
@inject ContactMessageController Messages

<PageTitle>Message</PageTitle>

<AdminPageLayout Title="Message" ToolbarItems="@DetailToolbar">
    @if (loading)
    {
        <p class="loading-state">Loading...</p>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p class="empty-state" style="color:var(--pico-del-color)">@errorMessage</p>
    }
    else if (message is null)
    {
        <p class="empty-state">Message not found.</p>
    }
    else
    {
        <p class="muted-sm" style="margin:0.25rem 0">From</p>
        <h3 style="margin-top:0">@message.Name</h3>
        <p><a href="mailto:@message.Email">@message.Email</a></p>
        <p class="muted-sm">@FormatDate(message.SubmittedUtc)</p>
        <p class="muted-sm">Ticket #@ticketNumber</p>
        <hr />
        <div style="white-space:pre-wrap">@message.Message</div>
        <hr />
        <button class="outline danger" @onclick="DeleteMessageAsync" aria-busy="@deleting"><i class="site-icon" data-lucide="trash-2"></i>Delete</button>
    }
</AdminPageLayout>

@code {
    [Parameter] public string MessageId { get; set; } = "";

    private bool loading = true;
    private bool deleting;
    private string errorMessage = "";
    private ContactMessage? message;
    private long ticketNumber;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            message = await Messages.GetMessageAsync(MessageId);
            if (message is not null)
            {
                ticketNumber = message.SubmittedUtc.ToUnixTimeMilliseconds();
            }
            if (message is not null && !message.IsRead)
            {
                await Messages.MarkReadAsync(MessageId);
                message.IsRead = true;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task DeleteMessageAsync()
    {
        deleting = true;
        errorMessage = "";
        try
        {
            await Messages.DeleteMessageAsync(MessageId);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            deleting = false;
        }
        if (string.IsNullOrWhiteSpace(errorMessage))
            Nav.NavigateTo("/admin/messages", replace: true);
    }

    private RenderFragment DetailToolbar => __builder =>
    {
        <button class="outline secondary btn-action" title="Back" aria-label="Back" @onclick='() => Nav.NavigateTo("/admin/messages")'><i class="site-icon" data-lucide="arrow-left"></i></button>
    };

    private static string FormatDate(DateTimeOffset dto)
    {
        var local = dto.ToLocalTime();
        return local.ToString("MMM d, yyyy") + " at " + local.ToString("h:mm tt").ToLowerInvariant();
    }
}
