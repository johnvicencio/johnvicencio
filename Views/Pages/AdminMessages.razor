@page "/admin/messages"
@inject NavigationManager Nav
@inject ContactMessageController Messages

<PageTitle>Messages</PageTitle>

<AdminPageLayout Title="Messages" ToolbarItems="@MessagesToolbar">

        @if (loading)
        {
            <p class="loading-state">Loading...</p>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <p class="empty-state text-danger">@errorMessage</p>
        }
        else if (filteredList.Count == 0)
        {
            <p class="empty-state">@(string.IsNullOrWhiteSpace(search) ? "No messages yet." : "No messages match your search.")</p>
        }
        else
        {
            <div class="table-wrap"><table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Message</th>
                        <th>Submitted</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var message in filteredList)
                    {
                        var snippet = GetSnippet(message);
                        <tr>
                            <td><strong>@message.Name</strong></td>
                            <td class="mono-text">@message.Email</td>
                            <td class="msg-snippet">@snippet</td>
                            <td class="msg-date">@FormatDate(message.SubmittedUtc)</td>
                            <td>
                                <button class="outline btn-action" title="Open Message" aria-label="Open Message" @onclick='() => Nav.NavigateTo($"/admin/messages/{message.Id}")'><i class="site-icon" data-lucide="@(message.IsRead ? "mail-open" : "mail")"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table></div>
        }
</AdminPageLayout>

@code {
    private bool loading = true;
    private string errorMessage = "";
    private List<ContactMessage> messageList = [];
    private List<ContactMessage> filteredList = [];
    private string search = "";
    private string searchQuery = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            messageList = await Messages.GetMessagesAsync();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private RenderFragment MessagesToolbar => __builder =>
    {
        <SearchFilter SearchQuery="@search" SearchQueryChanged="HandleSearch" Placeholder="Search name, email, or message..." />
        <button class="outline secondary btn-action" title="Back" aria-label="Back" @onclick='() => Nav.NavigateTo("/admin")'><i class="site-icon" data-lucide="arrow-left"></i></button>
    };

    private void HandleSearch(string val)
    {
        search = val;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            searchQuery = "";
            filteredList = [..messageList];
        }
        else
        {
            searchQuery = search.Trim();
            var q = searchQuery.ToLowerInvariant();
            filteredList = messageList
                .Where(m =>
                    m.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    m.Email.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    m.Message.Contains(q, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private string GetSnippet(ContactMessage message)
    {
        var text = message.Message.Replace("\r\n", " ").Replace("\n", " ").Replace("\r", " ");
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var idx = text.IndexOf(searchQuery, StringComparison.OrdinalIgnoreCase);
            if (idx >= 0)
            {
                var start = Math.Max(0, idx - 20);
                var len = Math.Min(searchQuery.Length + 40, text.Length - start);
                var snippet = (start > 0 ? "..." : "") + text.Substring(start, len) + (start + len < text.Length ? "..." : "");
                return snippet;
            }
        }
        if (text.Length <= 60) return text;
        return text[..57] + "...";
    }

    private static string FormatDate(DateTimeOffset dto)
    {
        var local = dto.ToLocalTime();
        return local.ToString("M/d/yyyy h:mm tt").ToLowerInvariant();
    }
}
