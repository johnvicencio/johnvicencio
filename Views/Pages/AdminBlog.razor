@page "/admin/blog"
@inject VaultSessionService Session
@inject NavigationManager Nav
@inject BlogController Blog
@inject PageController Pages

<PageTitle>Blog Posts</PageTitle>

<div class="login-page" style="width:100%">

    <article style="width:100%;max-width:1200px;margin:0 auto">
        <div class="table-toolbar">
            <h2 style="margin:0">Blog Posts</h2>
            <div style="display:flex;align-items:center;gap:0.75rem">
                <div class="table-search" style="display:flex;align-items:center;gap:0.5rem">
                    <span class="site-icon" data-lucide="search" style="flex-shrink:0;opacity:0.5"></span>
                    <input type="text" placeholder="Search title, slug, summary, content, or date..." value="@search" @oninput="OnSearchInput" style="margin:0;min-width:18rem" />
                    @if (!string.IsNullOrWhiteSpace(search))
                    {
                        <button class="outline secondary" style="padding:0.2rem 0.5rem;min-height:auto;font-size:0.8rem" @onclick="ClearSearch"><i class="site-icon" data-lucide="x"></i></button>
                    }
                </div>
                @if (hasBlogPage)
                {
                    <button class="outline" title="Add Post" aria-label="Add Post" @onclick='() => Nav.NavigateTo("/admin/blog/add")'><i class="site-icon" data-lucide="plus"></i></button>
                }
                <button class="outline secondary" title="Back" aria-label="Back" @onclick='() => Nav.NavigateTo("/admin")'><i class="site-icon" data-lucide="arrow-left"></i></button>
            </div>
        </div>

        @if (!hasBlogPage)
        {
            <p class="pagination-info" style="padding:1rem">Create a page with slug "blog" to enable blog management.</p>
        }

        @if (hasBlogPage && filteredList.Count == 0)
        {
            <p class="pagination-info" style="padding:1rem;text-align:center">@(postList.Count == 0 ? "No posts yet." : "No posts match your search.")</p>
        }

        @if (hasBlogPage && filteredList.Count > 0)
        {
            <table style="table-layout:fixed">
                <colgroup>
                    <col style="width:6rem" />
                    <col />
                    <col style="width:8rem" />
                    <col style="width:7rem" />
                    <col style="width:7rem" />
                </colgroup>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Title <span tabindex="0" class="sort-icon" @onclick="SortByTitle" @onkeydown="KeySortByTitle">@SortIcon("title")</span></th>
                        <th>Slug</th>
                        <th>Date <span tabindex="0" class="sort-icon" @onclick="SortByPublished" @onkeydown="KeySortByPublished">@SortIcon("published")</span></th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pt in PagedPosts)
                    {
                        <tr>
                            <td style="font-family:monospace;font-size:0.75rem">@pt.Id</td>
                            <td><strong>@pt.Title</strong></td>
                            <td>@pt.Slug</td>
                            <td>@pt.PublishedOn.ToString("M/d/yyyy")</td>
                            <td>
                                <button class="outline" title="Edit" aria-label="Edit" style="padding:0.25rem 0.5rem;font-size:0.75rem" @onclick='() => Nav.NavigateTo($"/admin/blog/edit/{pt.Id}")'><i class="site-icon" data-lucide="pencil"></i></button>
                                <button class="outline danger" title="Delete" aria-label="Delete" style="padding:0.25rem 0.5rem;font-size:0.75rem" @onclick='() => Nav.NavigateTo($"/admin/blog/delete/{pt.Id}")'><i class="site-icon" data-lucide="trash-2"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <PaginationBar CurrentPage="currentPage" TotalPages="TotalPages" OnPageChanged="HandlePageChanged" />
        }
    </article>

</div>

@code {
    private List<johnvicencio.Models.BlogPost> postList = [];
    private List<johnvicencio.Models.BlogPost> filteredList = [];
    private bool hasBlogPage;
    private string search = "";
    private int currentPage = 1;
    private const int PageSize = 10;
    private string sortBy = "published";
    private bool sortDesc = true;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(filteredList.Count / (double)PageSize));

    private IEnumerable<johnvicencio.Models.BlogPost> PagedPosts => filteredList
        .Skip((currentPage - 1) * PageSize)
        .Take(PageSize);

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }

        postList = await Blog.GetPostsAsync();
        ApplyFilter();
        var pageList = await Pages.GetPagesAsync();
        hasBlogPage = pageList.Any(p => p.Slug.Equals("blog", StringComparison.OrdinalIgnoreCase));
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? "";
        currentPage = 1;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        IEnumerable<johnvicencio.Models.BlogPost> query = postList;

        if (!string.IsNullOrWhiteSpace(search))
        {
            var q = search.Trim();
            query = query.Where(post =>
                post.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                post.Slug.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                post.Summary.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                post.Content.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                post.PublishedOn.ToString("yyyy-MM-dd").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                post.PublishedOn.ToString("MMMM d, yyyy").Contains(q, StringComparison.OrdinalIgnoreCase));
        }

        query = sortBy switch
        {
            "title" => sortDesc
                ? query.OrderByDescending(p => p.Title)
                : query.OrderBy(p => p.Title),
            "slug" => sortDesc
                ? query.OrderByDescending(p => p.Slug)
                : query.OrderBy(p => p.Slug),
            _ => sortDesc
                ? query.OrderByDescending(p => p.PublishedOn)
                : query.OrderBy(p => p.PublishedOn),
        };

        filteredList = query.ToList();
    }

    private void ToggleSort(string column)
    {
        if (sortBy == column)
            sortDesc = !sortDesc;
        else
        {
            sortBy = column;
            sortDesc = true;
        }
        currentPage = 1;
        ApplyFilter();
    }

    private void SortByTitle() => ToggleSort("title");
    private void SortByPublished() => ToggleSort("published");

    private void KeySortByTitle(KeyboardEventArgs e) { if (e.Key is "Enter" or " ") SortByTitle(); }
    private void KeySortByPublished(KeyboardEventArgs e) { if (e.Key is "Enter" or " ") SortByPublished(); }

    private string SortIcon(string column)
    {
        if (sortBy != column) return "\u25B2";
        return sortDesc ? "\u25BC" : "\u25B2";
    }

    private void ClearSearch()
    {
        search = "";
        currentPage = 1;
        ApplyFilter();
    }

    private void HandlePageChanged(int page)
    {
        currentPage = page;
    }

    private void PreviousPage()
    {
        if (currentPage > 1) currentPage--;
    }

    private void NextPage()
    {
        if (currentPage < TotalPages) currentPage++;
    }
}
