@page "/blog"
@inject BlogController BlogController
@inject RouterController Router
@inject IJSRuntime Js
@inject NavigationManager Nav

<PageTitle>Blog — John Vicencio</PageTitle>

<header>
    <h1>Blog</h1>
    <SearchFilter SearchQuery="@searchQuery" SearchQueryChanged="HandleSearch" Placeholder="Search posts..." />
</header>

@if (FilteredPosts.Count == 0)
{
    <p>No posts found.</p>
}
else
{
    <section>
        @foreach (var post in PagedPosts)
        {
            <article>
                @if (!string.IsNullOrWhiteSpace(post.ImageUrl))
                {
                    <figure>
                        <img src="@post.ImageUrl" alt="@post.Title" />
                    </figure>
                }
                <header>
                    <h2><a href="@Router.BlogPostPath(post.Slug)">@post.Title</a></h2>
                    <small><time datetime="@post.PublishedOn.ToString("yyyy-MM-dd")">@post.PublishedOn.ToString("MMMM d, yyyy")</time></small>
                </header>
                <p>@TruncateContent(post.Content, 200)</p>
                <footer>
                    <a href="@Router.BlogPostPath(post.Slug)" role="button" class="outline">Read more</a>
                </footer>
            </article>
        }
    </section>

    <PaginationBar CurrentPage="currentPage" TotalPages="TotalPages" PageUrl="GetPageUrl" />
}

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int? page { get; set; }

    private List<johnvicencio.Models.BlogPost> allPosts = [];
    private string searchQuery = "";
    private int prevPage = 0;
    private const int PageSize = 5;

    private int currentPage => page ?? 1;

    private List<johnvicencio.Models.BlogPost> FilteredPosts
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchQuery)) return allPosts;
            var q = searchQuery.Trim().ToLowerInvariant();
            return allPosts.Where(p =>
                (p.Title?.ToLowerInvariant().Contains(q) ?? false) ||
                (p.Summary?.ToLowerInvariant().Contains(q) ?? false) ||
                (p.Slug?.ToLowerInvariant().Contains(q) ?? false)
            ).ToList();
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredPosts.Count / (double)PageSize));

    private IEnumerable<johnvicencio.Models.BlogPost> PagedPosts => FilteredPosts
        .Skip((currentPage - 1) * PageSize)
        .Take(PageSize);

    private string GetPageUrl(int p)
    {
        if (p <= 1) return "/blog";
        return $"/blog?page={p}";
    }

    private void HandleSearch(string val)
    {
        searchQuery = val;
    }

    protected override async Task OnInitializedAsync()
    {
        allPosts = (await BlogController.GetPostsAsync())
            .OrderByDescending(post => post.PublishedOn)
            .ToList();
        if (currentPage > TotalPages)
        {
            Nav.NavigateTo(GetPageUrl(TotalPages), replace: true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Js.InvokeVoidAsync("setPageMeta", new
            {
                title = "Blog — John Vicencio",
                description = "Read the latest thoughts, projects, and insights from John Vicencio on C#, .NET, philosophy, and software craftsmanship."
            });
        }
        if (currentPage > 1 && currentPage != prevPage)
        {
            prevPage = currentPage;
            await Js.InvokeVoidAsync("scrollToPagination");
        }
        else if (currentPage != prevPage)
        {
            prevPage = currentPage;
        }
    }

    private static string TruncateContent(string html, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(html)) return "";
        var text = System.Text.RegularExpressions.Regex.Replace(html, "<[^>]+>", " ");
        text = System.Text.RegularExpressions.Regex.Replace(text, "\\s+", " ").Trim();
        return text.Length <= maxLength ? text : text[..maxLength] + "...";
    }

    private static string Truncate(string value, int maxLength)
    {
        if (string.IsNullOrEmpty(value)) return value;
        return value.Length <= maxLength ? value : value[..maxLength] + "...";
    }
}
