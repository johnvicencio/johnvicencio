@page "/contact"
@inject PageController Pages
@inject IJSRuntime Js

<PageTitle>Contact — John Vicencio</PageTitle>

@if (loading)
{
    <p>Loading contact page...</p>
}
else if (currentPage is null)
{
    <p>Contact page content was not found.</p>
}
else
{
    <SectionRenderer Sections="currentPage.Sections" />
}

@code {
    private Page? currentPage;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        currentPage = await Pages.GetPageAsync("contact");
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Js.InvokeVoidAsync("setPageMeta", new
            {
                title = "Contact — John Vicencio",
                description = "Get in touch with John Vicencio. Send a message, ask a question, or discuss a project."
            });
        }
    }
}
