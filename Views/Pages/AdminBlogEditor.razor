@page "/admin/blog/add"
@page "/admin/blog/edit/{PostId}"
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject BlogController Blog
@inject PageController Pages

<PageTitle>@title</PageTitle>

<AdminPageLayout Title="@title">
        @if (loading)
        {
            <p class="pagination-info" style="text-align:center">Loading...</p>
        }
        else if (!hasBlogPage)
        {
            <p class="pagination-info" style="padding:1rem">Create a page with slug "blog" to enable blog management.</p>
        }
        else
        {
            <div class="page-editor">
                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <p role="alert" class="form-alert form-alert-danger">@message</p>
                }

                <div class="grid grid-2col">
                    <label>Title
                        <input @bind="editPostTitle" @oninput="OnPostTitleChanged" />
                    </label>
                    <label>Slug
                        <input @bind="editPostSlug" />
                    </label>
                </div>

                <div class="grid grid-2col">
                    <label>Description (SEO)
                        <input @bind="editPostDescription" />
                    </label>
                    <label>Keywords (SEO)
                        <textarea @bind="editPostKeywords" rows="2" placeholder="comma, separated"></textarea>
                    </label>
                </div>

                <label>Content</label>
                <RichTextEditor @bind-Value="editPostContent" MinHeight="400" />

                <label>Post Image URL
                    <input @bind="editPostImageUrl" />
                </label>
                <button type="button" class="outline" @onclick="() => showImagePicker = true"><i class="site-icon" data-lucide="image"></i>Select Image</button>
                @if (!string.IsNullOrWhiteSpace(editPostImageUrl))
                {
                    <p class="pagination-info">Selected: <code>@editPostImageUrl</code></p>
                }
                @if (!string.IsNullOrWhiteSpace(editPostImageUrl))
                {
                    <img src="@editPostImageUrl" alt="Post image preview" style="width:100%;max-height:260px;object-fit:cover;border-radius:0.5rem" />
                }

                <label>Summary
                    <textarea @bind="editPostSummary" rows="2"></textarea>
                </label>

                <label>Published Date
                    <input type="date" value="@editPostDate" @onchange="OnPostDateChanged" />
                </label>

                <hr />
                <button @onclick="SavePost" aria-busy="@saving"><i class="site-icon" data-lucide="save"></i>Save Post</button>
                <button class="outline secondary" @onclick='() => Nav.NavigateTo("/admin/blog")'><i class="site-icon" data-lucide="x"></i>Cancel</button>

            </div>
        }
</AdminPageLayout>

@code {
    [Parameter]
    public string? PostId { get; set; }

    private bool loading = true;
    private bool saving;
    private bool isAddMode;
    private bool hasBlogPage;
    private string message = "";

    private string editPostTitle = "";
    private string editPostSlug = "";
    private string editPostDescription = "";
    private string editPostKeywords = "";
    private string editPostContent = "";
    private string editPostSummary = "";
    private string editPostImageUrl = "";
    private string editPostDate = "";
    private bool showImagePicker;

    private string title => PostId is null
        ? "Add Post"
        : string.IsNullOrWhiteSpace(editPostTitle) ? "Edit Post" : $"Edit {editPostTitle} Post";

    protected override async Task OnInitializedAsync()
    {
        isAddMode = PostId is null;
        var pageList = await Pages.GetPagesAsync();
        hasBlogPage = pageList.Any(p => p.Slug.Equals("blog", StringComparison.OrdinalIgnoreCase));

        if (!isAddMode && hasBlogPage)
        {
            var posts = await Blog.GetPostsAsync();
            var post = posts.FirstOrDefault(p => p.Id == PostId);
            if (post is not null)
            {
                editPostTitle = post.Title;
                editPostSlug = post.Slug;
                editPostDescription = post.Description;
                editPostKeywords = post.Keywords;
                editPostContent = post.Content;
                editPostSummary = post.Summary;
                editPostImageUrl = post.ImageUrl;
                editPostDate = post.PublishedOn.ToString("yyyy-MM-dd");
            }
        }

        if (isAddMode)
        {
            editPostDate = DateOnly.FromDateTime(DateTime.UtcNow).ToString("yyyy-MM-dd");
        }

        loading = false;
    }

    private void OnPostTitleChanged(ChangeEventArgs e)
    {
        editPostTitle = e.Value?.ToString() ?? "";
        if (isAddMode)
        {
            editPostSlug = ToSlug(editPostTitle);
        }
    }

    private void OnPostDateChanged(ChangeEventArgs e)
    {
        editPostDate = e.Value?.ToString() ?? "";
    }

    private async Task SavePost()
    {
        saving = true;
        message = "";
        try
        {
            var existingPost = isAddMode ? null : (await Blog.GetPostsAsync()).FirstOrDefault(p => p.Id == PostId);
            var post = new johnvicencio.Models.BlogPost
            {
                Id = existingPost?.Id ?? Guid.NewGuid().ToString("N")[..12],
                Title = editPostTitle,
                Slug = editPostSlug,
                Description = editPostDescription,
                Keywords = editPostKeywords,
                Content = editPostContent,
                Summary = editPostSummary,
                ImageUrl = editPostImageUrl,
                PublishedOn = DateOnly.TryParse(editPostDate, out var d) ? d : DateOnly.FromDateTime(DateTime.UtcNow),
            };

            if (existingPost is not null)
                await Blog.UpdatePostAsync(post);
            else
                await Blog.AddPostAsync(post);

            Nav.NavigateTo("/admin/blog");
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private Task SetImagePath(string path)
    {
        editPostImageUrl = path;
        return Task.CompletedTask;
    }

    static string ToSlug(string title) => SlugHelper.ToSlug(title);
}

<ImagePicker Open="showImagePicker" Value="editPostImageUrl" ValueChanged="SetImagePath" OnClose="() => showImagePicker = false" />

