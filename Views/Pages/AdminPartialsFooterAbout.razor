@page "/admin/partials/footerabout"
@inject VaultSessionService Session
@inject NavigationManager Nav
@inject SiteController Site
@inject IJSRuntime Js

<PageTitle>Footer About</PageTitle>

<div class="login-page" style="width:100%">

    <article style="width:100%;max-width:1200px;margin:0 auto">
        <div class="table-toolbar">
            <h2 style="margin:0">Footer About</h2>
            <div>
                <button class="outline secondary" @onclick='() => Nav.NavigateTo("/admin/partials")'><i class="site-icon" data-lucide="arrow-left"></i>Back</button>
            </div>
        </div>

        <p style="font-size:0.9rem;color:var(--app-muted)">
            Edit the header and about text that appear in the footer About column.
        </p>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <p role="alert" class="form-alert form-alert-success">@message</p>
        }

        <label for="footer-about-header">Header</label>
        <input id="footer-about-header" @bind="footerAboutHeader" placeholder="e.g. About John Vicencio" />

        <label for="footer-about-text" style="margin-top:1rem">About Text</label>
        <RichTextEditor @bind-Value="footerAbout" MinHeight="220" Placeholder="Write about yourself..." />

        <div style="display:flex;gap:0.5rem;margin-top:1rem">
            <button @onclick="Save" aria-busy="@saving"><i class="site-icon" data-lucide="save"></i>Save</button>
        </div>

    </article>

</div>

@code {
    private bool saving;
    private string message = "";
    private string footerAboutHeader = "";
    private string footerAbout = "";

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }

        var settings = await Site.GetSettingsAsync();
        footerAboutHeader = settings.FooterAboutHeader ?? "";
        footerAbout = settings.FooterAbout ?? "";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await Js.InvokeVoidAsync("lucide.createIcons");
    }

    private async Task Save()
    {
        saving = true;
        message = "";
        try
        {
            var settings = await Site.GetSettingsAsync();
            settings.FooterAboutHeader = footerAboutHeader;
            settings.FooterAbout = footerAbout;
            await Site.UpdateSettingsAsync(settings);
            Nav.NavigateTo("/admin/partials");
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }
}
