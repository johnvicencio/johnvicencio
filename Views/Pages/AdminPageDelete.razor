@page "/admin/pages/delete/{PageId}"
@inject PageController Pages

<PageTitle>Delete Page</PageTitle>

<DeleteConfirm ItemTitle="@currentPage?.Title" ItemDetail="@($"slug: {currentPage?.Slug}, {currentPage?.Sections.Count} section(s)")" ResourceName="Page" CancelUrl="/admin/pages" OnConfirm="ConfirmDelete" />

@code {
    [Parameter] public string PageId { get; set; } = "";

    private Page? currentPage;

    protected override async Task OnParametersSetAsync()
    {
        var pages = await Pages.GetPagesAsync();
        currentPage = pages.FirstOrDefault(p => p.Id == PageId);
    }

    private async Task ConfirmDelete()
    {
        if (currentPage is not null)
            await Pages.DeletePageAsync(PageId);
    }
}
