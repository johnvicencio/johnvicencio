@page "/admin/change-password"
@inject IJSRuntime Js
@inject VaultSessionService Session
@inject VaultController Vaults
@inject NavigationManager Nav

<PageTitle>Change Password</PageTitle>

<AdminPageLayout Title="Change Password">
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p role="alert" class="form-alert form-alert-@(success ? "success" : "danger")">@message</p>
    }

    @if (!success)
    {
        <EditForm Model="form" OnValidSubmit="ChangePasswordAsync" class="page-editor">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <label>Current Password
                <InputText type="password" @bind-Value="form.CurrentPassphrase" autocomplete="current-password" />
            </label>

            <label>New Password
                <InputText type="password" @bind-Value="form.NewPassphrase" autocomplete="new-password" />
            </label>
            <p class="muted-sm" style="margin-top:-0.5rem">At least 10 characters.</p>

            <label>Confirm New Password
                <InputText type="password" @bind-Value="form.ConfirmPassphrase" autocomplete="new-password" />
            </label>

            <hr />
            <button type="submit" aria-busy="@saving"><i class="site-icon" data-lucide="save"></i>Change Password</button>
            <button type="button" class="outline secondary" @onclick='() => Nav.NavigateTo("/admin")'><i class="site-icon" data-lucide="x"></i>Cancel</button>
        </EditForm>
    }
</AdminPageLayout>

@code {
    private PasswordForm form = new();
    private bool saving;
    private string message = "";
    private bool success;

    protected override async Task OnInitializedAsync()
    {
        // ponytail: session guard handled by AdminPageLayout
    }

    private async Task ChangePasswordAsync()
    {
        if (form.NewPassphrase != form.ConfirmPassphrase)
        {
            message = "New password and confirmation do not match.";
            return;
        }

        if (form.NewPassphrase.Length < 10)
        {
            message = "New password must be at least 10 characters.";
            return;
        }

        saving = true;
        message = "";

        try
        {
            var result = await Vaults.ChangePasswordAsync(form.CurrentPassphrase, form.NewPassphrase);
            if (result.Success)
            {
                success = true;
                message = result.Message + " Please log in again with your new password.";
                Session.SignOut();
                await Session.ClearStorageAsync(Js);
            }
            else
            {
                message = result.Message;
            }
        }
        catch
        {
            message = "Could not change password. Try again.";
        }
        finally
        {
            saving = false;
        }
    }

    private sealed class PasswordForm
    {
        public string CurrentPassphrase { get; set; } = "";
        public string NewPassphrase { get; set; } = "";
        public string ConfirmPassphrase { get; set; } = "";
    }
}

