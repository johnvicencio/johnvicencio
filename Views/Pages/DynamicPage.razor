@page "/{Slug}"
@inject PageController Pages
@inject IJSRuntime Js

<PageTitle>@(currentPage is not null ? $"{currentPage.Title} — John Vicencio" : "Not found — John Vicencio")</PageTitle>

@if (loading)
{
}
else if (currentPage is null)
{
    <h1>Page not found</h1>
    <p role="alert">Sorry, there's nothing at this address.</p>
}
else
{
    <SectionRenderer Sections="currentPage.Sections" />
}

@code {
    [Parameter]
    public string? Slug { get; set; }

    private Page? currentPage;
    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        currentPage = string.IsNullOrWhiteSpace(Slug)
            ? null
            : await Pages.GetPageAsync(Slug);
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (currentPage is not null)
        {
            var desc = !string.IsNullOrWhiteSpace(currentPage.Description)
                ? currentPage.Description
                : $"{currentPage.Title} — John Vicencio";
            await Js.InvokeVoidAsync("setPageMeta", new
            {
                title = $"{currentPage.Title} — John Vicencio",
                description = desc
            });
        }
    }
}
