@page "/about"
@inject PageController Pages
@inject IJSRuntime Js

<PageTitle>About — John Vicencio</PageTitle>

@if (loading)
{
}
else if (currentPage is null)
{
    <h1>About</h1>
    <p>About page content was not found.</p>
}
else
{
    <SectionRenderer Sections="currentPage.Sections" />
}

@code {
    private Page? currentPage;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        currentPage = await Pages.GetPageAsync("about");
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Js.InvokeVoidAsync("setPageMeta", new
            {
                title = "About — John Vicencio",
                description = "Learn about John Vicencio — C# / .NET developer, philosopher, and lifelong learner blending software craftsmanship with depth and clarity."
            });
        }
    }
}
