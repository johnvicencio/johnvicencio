@page "/about"
@inject PageController Pages

<PageTitle>About</PageTitle>

@if (currentPage is null)
{
    <p>Loading about page...</p>
}
else
{
    <h1>@currentPage.Title</h1>
    <p>@currentPage.Description</p>

    @foreach (var section in currentPage.Sections)
    {
        if (section.Type.Equals("hero", StringComparison.OrdinalIgnoreCase))
        {
            <HeroView Section="section" />
        }
        else if (section.Type.Equals("2-col", StringComparison.OrdinalIgnoreCase))
        {
            <TwoColView Section="section" />
        }
        else if (section.Type.Equals("3-col", StringComparison.OrdinalIgnoreCase))
        {
            <ThreeColView Section="section" />
        }
        else if (section.Type.Equals("cards", StringComparison.OrdinalIgnoreCase) || section.Type.Equals("cardcollection", StringComparison.OrdinalIgnoreCase))
        {
            <CardCollectionView Section="section" />
        }
        else if (section.Type.Equals("contact", StringComparison.OrdinalIgnoreCase))
        {
            <ContactView Section="section" />
        }
        else
        {
            <ContentView Section="section" />
        }
    }
}

@code {
    private Page? currentPage;

    protected override async Task OnInitializedAsync()
    {
        currentPage = await Pages.GetPageAsync("about");
    }
}
