@page "/login"
@inject IJSRuntime Js
@inject VaultController Vaults
@inject VaultSessionService Session
@inject NavigationManager Navigation

<PageTitle>Login — John Vicencio</PageTitle>

<div class="login-page">
<h1>Login</h1>
<p>Type your username and password:</p>

@if (!string.IsNullOrWhiteSpace(message))
{
    <p role="alert" class="form-alert form-alert-danger">@message</p>
}

<EditForm Model="loginForm" OnValidSubmit="UnlockVaultAsync" class="login-form">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <InputText @bind-Value="loginForm.Username" placeholder="Username" autocomplete="username" />
    <InputText type="password" @bind-Value="loginForm.Passphrase" placeholder="Password" autocomplete="current-password" />

    <button type="submit" aria-busy="@isBusy">Submit</button>

    <p class="muted-sm mt-1">
        <a href="/admin/reset-password">Forgot your password?</a>
    </p>
</EditForm>
</div>

@code {
    private readonly LoginForm loginForm = new();
    private bool isBusy;
    private string message = string.Empty;
    private VaultLoginResult? result;

    protected override async Task OnInitializedAsync()
    {
        await Session.TryRestoreAsync(Js);

        if (Session.IsLoggedIn)
            Navigation.NavigateTo(Session.ReturnUrl ?? "/admin", replace: true);
    }

    private async Task UnlockVaultAsync()
    {
        isBusy = true;
        message = string.Empty;
        result = null;

        try
        {
            result = await Vaults.LoginAsync(loginForm.Username, loginForm.Passphrase);

            if (result.Unlocked && result.Vault is not null && result.Payload is not null)
            {
                Session.SignIn(result.Vault, result.Payload);
                await Session.PersistAsync(Js);
                var redirect = Session.ReturnUrl ?? "/admin";
                Session.ReturnUrl = null;
                Navigation.NavigateTo(redirect, replace: true);
                return;
            }

            message = result.Message;
        }
        catch
        {
            message = "Login could not be completed. Check the username and password, then try again.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed class LoginForm
    {
        public string Username { get; set; } = string.Empty;

        public string Passphrase { get; set; } = string.Empty;
    }
}

