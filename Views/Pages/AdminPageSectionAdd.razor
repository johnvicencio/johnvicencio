@page "/admin/pages/{PageId}/sections/add"
@inject NavigationManager Nav
@inject PageController Pages

<PageTitle>Add @(page?.Title ?? "Page") Section</PageTitle>

<AdminPageLayout Title="@pageTitle" ToolbarItems="@SectionAddToolbar">
    @if (loading)
    {
        <p aria-busy="true">Loading...</p>
    }
    else if (page is null)
    {
        <p>Page not found.</p>
    }
    else
    {
        <label>Section ID
            <input readonly value="@sectionId" />
        </label>

        <small>Choose a section type:</small>

        <div class="grid">
            <button class="outline" @onclick='() => Nav.NavigateTo($"/admin/pages/{PageId}/sections/{sectionId}/hero/add")'>
                <i class="site-icon" data-lucide="image"></i>
                <span>Hero</span>
            </button>
            <button class="outline" @onclick='() => Nav.NavigateTo($"/admin/pages/{PageId}/sections/{sectionId}/2-col/add")'>
                <i class="site-icon" data-lucide="columns-2"></i>
                <span>2 Columns</span>
            </button>
            <button class="outline" @onclick='() => Nav.NavigateTo($"/admin/pages/{PageId}/sections/{sectionId}/3-col/add")'>
                <i class="site-icon" data-lucide="columns-3"></i>
                <span>3 Columns</span>
            </button>
            <button class="outline" @onclick='() => Nav.NavigateTo($"/admin/pages/{PageId}/sections/{sectionId}/cards/add")'>
                <i class="site-icon" data-lucide="list"></i>
                <span>Row Card</span>
            </button>
            <button class="outline" @onclick='() => Nav.NavigateTo($"/admin/pages/{PageId}/sections/{sectionId}/grid-card/add")'>
                <i class="site-icon" data-lucide="layout-grid"></i>
                <span>Grid Card</span>
            </button>
            <button class="outline" @onclick='() => Nav.NavigateTo($"/admin/pages/{PageId}/sections/{sectionId}/content/add")'>
                <i class="site-icon" data-lucide="file-text"></i>
                <span>Content</span>
            </button>
            <button class="outline" @onclick='() => Nav.NavigateTo($"/admin/pages/{PageId}/sections/{sectionId}/contact/add")'>
                <i class="site-icon" data-lucide="mail"></i>
                <span>Contact</span>
            </button>
        </div>
    }
</AdminPageLayout>

@code {
    [Parameter]
    public string PageId { get; set; } = "";

    private string pageTitle => $"Add {page?.Title ?? "Page"} Section";

    private RenderFragment SectionAddToolbar => __builder =>
    {
        <button class="outline secondary" title="Back" aria-label="Back" @onclick='() => Nav.NavigateTo($"/admin/pages/{PageId}/sections")'><i class="site-icon" data-lucide="arrow-left"></i></button>
    };

    private bool loading = true;
    private Page? page;
    private string sectionId = Guid.NewGuid().ToString("N")[..8];

    protected override async Task OnInitializedAsync()
    {
        page = await Pages.GetPageByIdAsync(PageId);
        if (page is null) { loading = false; return; }
        if (page.Slug.Equals("blog", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo($"/admin/pages/edit/{PageId}", replace: true);
            return;
        }

        loading = false;
    }
}
