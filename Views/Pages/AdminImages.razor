@page "/admin/images"
@inject ImageAssetController Images

<PageTitle>Images</PageTitle>

<AdminPageLayout Title="Images">
    <p class="muted-sm">Browse static images from <code>wwwroot/images</code>. This page reads <code>/images/index.json</code>, so add new files to <code>wwwroot/images</code> and regenerate the index when the folder changes.</p>
    @if (folders.Count > 0)
    {
        <label>Folder
            <select @bind="selectedFolder">
                <option value="">All images</option>
                @foreach (var folder in folders)
                {
                    <option value="@folder">@folder</option>
                }
            </select>
        </label>
    }
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p role="alert" class="form-alert">@message</p>
    }

    <hr />

    @if (loading)
    {
        <p class="loading-state">Loading...</p>
    }
    else if (VisibleImages.Count == 0)
    {
        <p class="empty-state">No images found.</p>
    }
    else
    {
        <div class="image-picker-grid">
            @foreach (var image in VisibleImages)
            {
                <article>
                    <img src="@image.Url" alt="@image.FileName" class="thumbnail" style="aspect-ratio:4/3" />
                    <p class="mono-text">@image.FileName</p>
                    @if (!string.IsNullOrWhiteSpace(image.Folder))
                    {
                        <p class="muted-sm">@image.Folder</p>
                    }
                    <label>Relative Path
                        <input readonly value="@image.Url" />
                    </label>
                    <button class="outline btn-action" @onclick="() => SelectImage(image.Url)"><i class="site-icon" data-lucide="check"></i>Select</button>
                </article>
            }
        </div>
    }
</AdminPageLayout>

@code {
    private bool loading = true;
    private string message = "";
    private string selectedFolder = "";
    private List<ImageAsset> imageList = [];
    private List<string> folders = [];
    private List<ImageAsset> VisibleImages => string.IsNullOrWhiteSpace(selectedFolder)
        ? imageList
        : imageList.Where(image => image.Folder == selectedFolder).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadImagesAsync();
    }

    private async Task LoadImagesAsync()
    {
        loading = true;
        try
        {
            imageList = await Images.GetImagesAsync();
            folders = imageList.Select(image => image.Folder).Where(folder => !string.IsNullOrWhiteSpace(folder)).Distinct().OrderBy(folder => folder).ToList();
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void SelectImage(string url)
    {
        message = $"Selected image path: {url}";
    }
}
