@page "/admin/partials"
@inject NavigationManager Nav

<PageTitle>Partials</PageTitle>

<AdminPageLayout Title="Partials">
    <div class="grid">

        <article>
            <header>
                <h3>Nav Bar</h3>
            </header>
            <small>Manage all nav bar links. Add, edit, delete, reorder, or sync from pages.</small>
            <footer>
                <button class="outline" title="Manage Nav Bar" aria-label="Manage Nav Bar" @onclick='() => Nav.NavigateTo("/admin/partials/navmenu")'><i class="site-icon" data-lucide="menu"></i></button>
            </footer>
        </article>

        <article>
            <header>
                <h3>Footer About</h3>
            </header>
            <small>Edit the about text that appears in the footer.</small>
            <footer>
                <button class="outline" title="Manage Footer About" aria-label="Manage Footer About" @onclick='() => Nav.NavigateTo("/admin/partials/footerabout")'><i class="site-icon" data-lucide="align-left"></i></button>
            </footer>
        </article>

        <article>
            <header>
                <h3>Footer Sections</h3>
            </header>
            <small>Manage section links that appear in the footer.</small>
            <footer>
                <button class="outline" title="Manage Footer Sections" aria-label="Manage Footer Sections" @onclick='() => Nav.NavigateTo("/admin/partials/footersections")'><i class="site-icon" data-lucide="list"></i></button>
            </footer>
        </article>

        <article>
            <header>
                <h3>Footer Connect</h3>
            </header>
            <small>Manage social media / connect links in the footer.</small>
            <footer>
                <button class="outline" title="Manage Footer Connect" aria-label="Manage Footer Connect" @onclick='() => Nav.NavigateTo("/admin/partials/footerconnect")'><i class="site-icon" data-lucide="share-2"></i></button>
            </footer>
        </article>

    </div>
</AdminPageLayout>

@code {
}
