@page "/admin/pages/{PageId}/sections/delete/{SectionId}"
@inject NavigationManager Nav
@inject PageController Pages

<PageTitle>@title</PageTitle>

<AdminPageLayout Title="@title">
    @if (loading)
    {
        <p aria-busy="true">Loading...</p>
    }
    else if (page is null)
    {
        <p>Page not found.</p>
    }
    else if (sec is null)
    {
        <p>Section not found.</p>
    }
    else
    {
        <p>
            Are you sure you want to delete the <strong>@SlugHelper.SectionTypeDisplayName(sec.Type)</strong> section
            "@(string.IsNullOrWhiteSpace(sec.Heading) ? "(no heading)" : sec.Heading)"?
        </p>
        <small>This will permanently remove this section from the page.</small>
        <hr />
        <div role="group">
            <button class="outline danger" @onclick="ConfirmDelete" aria-busy="@deleting"><i class="site-icon" data-lucide="trash-2"></i>Yes, Delete</button>
            <button class="outline secondary" @onclick='() => Nav.NavigateTo($"/admin/pages/{PageId}/sections")'><i class="site-icon" data-lucide="x"></i>Cancel</button>
        </div>
    }
</AdminPageLayout>

@code {
    [Parameter] public string PageId { get; set; } = "";
    [Parameter] public string SectionId { get; set; } = "";

    private bool loading = true;
    private bool deleting;
    private Page? page;
    private PageSection? sec;

    private string title
    {
        get
        {
            var pageName = page?.Title ?? "Page";
            var typeName = SlugHelper.SectionTypeDisplayName(sec?.Type);
            return string.IsNullOrWhiteSpace(typeName)
                ? $"Delete {pageName} Section"
                : $"Delete {pageName} {typeName} Section";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        page = await Pages.GetPageByIdAsync(PageId);
        sec = page?.Sections.FirstOrDefault(s => s.SectionId == SectionId);
        loading = false;
    }

    private async Task ConfirmDelete()
    {
        deleting = true;
        try
        {
            page = await Pages.GetPageByIdAsync(PageId);
            if (page is not null)
            {
                page.Sections.RemoveAll(s => s.SectionId == SectionId);
                await Pages.UpdatePageAsync(page);
            }
        }
        finally
        {
            deleting = false;
            Nav.NavigateTo($"/admin/pages/{PageId}/sections");
        }
    }
}
