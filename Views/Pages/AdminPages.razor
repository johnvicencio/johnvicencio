@page "/admin/pages"
@inject VaultSessionService Session
@inject NavigationManager Nav
@inject PageController Pages

<PageTitle>Admin — Pages</PageTitle>

<div class="login-page" style="width:100%">

    <article style="width:100%;max-width:960px;margin:0 auto">
        <div class="table-toolbar">
            <h2 style="margin:0">Pages</h2>
            <div style="display:flex;gap:0.5rem">
                <button class="outline secondary" @onclick='() => Nav.NavigateTo("/admin")'><i class="site-icon" data-lucide="arrow-left"></i>Back</button>
                <button class="outline" @onclick='() => Nav.NavigateTo("/admin/pages/add")'><i class="site-icon" data-lucide="plus"></i>Add Page</button>
            </div>
        </div>

        @if (pageList.Count == 0)
        {
            <p class="pagination-info" style="padding:1rem;text-align:center">No pages yet.</p>
        }

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Slug</th>
                    <th>Sections</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pg in pageList)
                {
                    <tr>
                        <td style="font-family:monospace;font-size:0.75rem">@pg.Id</td>
                        <td><strong>@pg.Title</strong></td>
                        <td>@pg.Slug</td>
                        <td>@pg.Sections.Count</td>
                        <td>
                            <button class="outline" style="padding:0.25rem 0.5rem;font-size:0.75rem" @onclick='() => Nav.NavigateTo($"/admin/pages/edit/{pg.Id}")'><i class="site-icon" data-lucide="pencil"></i>Edit</button>
                            <button class="outline danger" style="padding:0.25rem 0.5rem;font-size:0.75rem" @onclick='() => Nav.NavigateTo($"/admin/pages/delete/{pg.Id}")'><i class="site-icon" data-lucide="trash-2"></i>Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </article>

</div>

@code {
    private List<Page> pageList = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }

        pageList = await Pages.GetPagesAsync();
    }
}
