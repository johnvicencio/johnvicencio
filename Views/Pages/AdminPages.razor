@page "/admin/pages"
@inject NavigationManager Nav
@inject PageController Pages

<PageTitle>Pages</PageTitle>

<AdminPageLayout Title="Pages" ToolbarItems="@PagesToolbar">
    @if (pageList.Count == 0)
    {
        <p class="empty-state">No pages yet.</p>
    }

    <div class="table-wrap"><table>
        <thead>
            <tr>
                <th>Title</th>
                <th>Slug</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pg in pageList)
            {
                var orderIndex = movablePages.IndexOf(pg);
                <tr>
                    <td><strong>@pg.Title</strong></td>
                    <td>@pg.Slug</td>
                    <td>
                        @if (orderIndex >= 0)
                        {
                            <button class="outline secondary btn-action" title="Move Up" aria-label="Move Up" disabled="@(savingOrder || orderIndex == 0)" @onclick="() => MovePageAsync(pg.Id, -1)"><i class="site-icon" data-lucide="arrow-up"></i></button>
                            <button class="outline secondary btn-action" title="Move Down" aria-label="Move Down" disabled="@(savingOrder || orderIndex == movablePages.Count - 1)" @onclick="() => MovePageAsync(pg.Id, 1)"><i class="site-icon" data-lucide="arrow-down"></i></button>
                        }
                        <button class="outline btn-action" title="Edit" aria-label="Edit" @onclick='() => Nav.NavigateTo($"/admin/pages/edit/{pg.Id}")'><i class="site-icon" data-lucide="pencil"></i></button>
                        <button class="outline danger btn-action" title="Delete" aria-label="Delete" @onclick='() => Nav.NavigateTo($"/admin/pages/delete/{pg.Id}")'><i class="site-icon" data-lucide="trash-2"></i></button>
                    </td>
                </tr>
            }
        </tbody>
    </table></div>
</AdminPageLayout>

@code {
    private List<Page> pageList = [];
    private bool savingOrder;

    private List<Page> movablePages => pageList.Where(p => !IsLegalPage(p.Slug)).ToList();

    private RenderFragment PagesToolbar => __builder =>
    {
        <button class="outline" title="Add Page" aria-label="Add Page" @onclick='() => Nav.NavigateTo("/admin/pages/add")'><i class="site-icon" data-lucide="plus"></i></button>
        <button class="outline secondary btn-action" title="Back" aria-label="Back" @onclick='() => Nav.NavigateTo("/admin")'><i class="site-icon" data-lucide="arrow-left"></i></button>
    };

    private static bool IsLegalPage(string slug) =>
        slug.Equals("terms-and-conditions", StringComparison.OrdinalIgnoreCase) ||
        slug.Equals("privacy-policy", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        pageList = await Pages.GetPagesAsync();
    }

    private async Task MovePageAsync(string pageId, int direction)
    {
        savingOrder = true;
        try
        {
            await Pages.MovePageAsync(pageId, direction);
            pageList = await Pages.GetPagesAsync();
        }
        finally
        {
            savingOrder = false;
        }
    }
}
