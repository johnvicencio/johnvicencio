@page "/admin/pages"
@inject VaultSessionService Session
@inject NavigationManager Nav
@inject PageController Pages

<PageTitle>Admin — Pages</PageTitle>

<div class="login-page" style="width:100%">

    <article style="width:100%;max-width:960px;margin:0 auto">
        <div class="table-toolbar">
            <h2 style="margin:0">Pages</h2>
            <div style="display:flex;gap:0.5rem">
                <button class="outline secondary" title="Back" aria-label="Back" @onclick='() => Nav.NavigateTo("/admin")'><i class="site-icon" data-lucide="arrow-left"></i></button>
                <button class="outline" title="Add Page" aria-label="Add Page" @onclick='() => Nav.NavigateTo("/admin/pages/add")'><i class="site-icon" data-lucide="plus"></i></button>
            </div>
        </div>

        @if (pageList.Count == 0)
        {
            <p class="pagination-info" style="padding:1rem;text-align:center">No pages yet.</p>
        }

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Slug</th>
                    <th>Sections</th>
                    <th>Order</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pg in OrderedPages)
                {
                    var movablePages = OrderedPages.Where(p => !p.Slug.Equals("home", StringComparison.OrdinalIgnoreCase)).ToList();
                    var orderIndex = movablePages.FindIndex(p => p.Id == pg.Id);
                    var isHome = pg.Slug.Equals("home", StringComparison.OrdinalIgnoreCase);
                    <tr>
                        <td style="font-family:monospace;font-size:0.75rem">@pg.Id</td>
                        <td><strong>@pg.Title</strong></td>
                        <td>@pg.Slug</td>
                        <td>@pg.Sections.Count</td>
                        <td>
                            @if (isHome)
                            {
                                <span class="pagination-info">Locked</span>
                            }
                            else
                            {
                                <div style="display:flex;gap:0.25rem;align-items:center">
                                    <span style="font-family:monospace;font-size:0.75rem">@pg.SortOrder</span>
                                    <button class="outline secondary" title="Move Up" aria-label="Move Up" disabled="@(savingOrder || orderIndex == 0)" style="padding:0.25rem 0.5rem;font-size:0.75rem" @onclick="() => MovePageAsync(pg.Id, -1)"><i class="site-icon" data-lucide="arrow-up"></i></button>
                                    <button class="outline secondary" title="Move Down" aria-label="Move Down" disabled="@(savingOrder || orderIndex == movablePages.Count - 1)" style="padding:0.25rem 0.5rem;font-size:0.75rem" @onclick="() => MovePageAsync(pg.Id, 1)"><i class="site-icon" data-lucide="arrow-down"></i></button>
                                </div>
                            }
                        </td>
                        <td>
                            <button class="outline" title="Edit" aria-label="Edit" style="padding:0.25rem 0.5rem;font-size:0.75rem" @onclick='() => Nav.NavigateTo($"/admin/pages/edit/{pg.Id}")'><i class="site-icon" data-lucide="pencil"></i></button>
                            <button class="outline danger" title="Delete" aria-label="Delete" style="padding:0.25rem 0.5rem;font-size:0.75rem" @onclick='() => Nav.NavigateTo($"/admin/pages/delete/{pg.Id}")'><i class="site-icon" data-lucide="trash-2"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </article>

</div>

@code {
    private List<Page> pageList = [];
    private bool savingOrder;
    private List<Page> OrderedPages => pageList.OrderBy(p => p.Slug.Equals("home", StringComparison.OrdinalIgnoreCase) ? -1 : p.SortOrder).ThenBy(p => p.Title).ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }

        pageList = await Pages.GetPagesAsync();
    }

    private async Task MovePageAsync(string pageId, int direction)
    {
        savingOrder = true;
        try
        {
            await Pages.MovePageAsync(pageId, direction);
            pageList = await Pages.GetPagesAsync();
        }
        finally
        {
            savingOrder = false;
        }
    }
}
