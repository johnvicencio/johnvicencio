@page "/admin/blog/delete/{PostId}"
@inject BlogController Blog

<PageTitle>Delete Post</PageTitle>

<DeleteConfirm ItemTitle="@post?.Title" ItemDetail="@($"slug: {post?.Slug}")" ResourceName="Post" CancelUrl="/admin/blog" OnConfirm="ConfirmDelete" />

@code {
    [Parameter] public string PostId { get; set; } = "";

    private johnvicencio.Models.BlogPost? post;

    protected override async Task OnParametersSetAsync()
    {
        var posts = await Blog.GetPostsAsync();
        post = posts.FirstOrDefault(p => p.Id == PostId);
    }

    private async Task ConfirmDelete()
    {
        if (post is not null)
            await Blog.DeletePostAsync(PostId);
    }
}
