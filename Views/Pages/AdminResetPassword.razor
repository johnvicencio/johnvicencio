@page "/admin/reset-password"
@inject VaultController Vaults
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Reset Password</PageTitle>

<section class="login-page">

    <article>
        <div class="table-toolbar">
            <h2>Reset Password</h2>
            <div>
                <button class="outline secondary" @onclick='() => Nav.NavigateTo("/login")'><i class="site-icon" data-lucide="arrow-left"></i>Back</button>
            </div>
        </div>

        <p>This creates a new admin vault with a fresh password. You need the Netlify content write token to save the change.</p>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <p role="alert" class="form-alert form-alert-@(success ? "success" : "danger")">@message</p>
        }

        @if (!success)
        {
            <EditForm Model="form" OnValidSubmit="ResetPasswordAsync" class="page-editor">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <label>New Password
                    <InputText type="password" @bind-Value="form.NewPassphrase" autocomplete="new-password" />
                </label>
                <p class="muted-sm">At least 10 characters.</p>

                <label>Confirm New Password
                    <InputText type="password" @bind-Value="form.ConfirmPassphrase" autocomplete="new-password" />
                </label>

                <label>Content Write Token
                    <InputText type="password" @bind-Value="form.ContentToken" placeholder="Saved from browser or paste here" />
                </label>
                <p class="muted-sm">Required to save the new vault to Netlify Blobs. Paste the <code>CONTENT_WRITE_TOKEN</code> if not already saved in this browser.</p>

                <hr />
                <button type="submit" aria-busy="@saving"><i class="site-icon" data-lucide="save"></i>Reset Password</button>
                <button type="button" class="outline secondary" @onclick='() => Nav.NavigateTo("/login")'><i class="site-icon" data-lucide="x"></i>Cancel</button>
            </EditForm>
        }
        else
        {
            <button class="outline" @onclick='() => Nav.NavigateTo("/login")'><i class="site-icon" data-lucide="log-in"></i>Go to Login</button>
        }
    </article>

</section>

@code {
    private ResetForm form = new();
    private bool saving;
    private string message = "";
    private bool success;

    protected override async Task OnInitializedAsync()
    {
        var existing = await Js.InvokeAsync<string?>("window.localStorage.getItem", "jv_content_token");
        if (!string.IsNullOrWhiteSpace(existing))
        {
            form.ContentToken = existing;
        }
    }

    private async Task ResetPasswordAsync()
    {
        if (form.NewPassphrase != form.ConfirmPassphrase)
        {
            message = "New password and confirmation do not match.";
            return;
        }

        if (form.NewPassphrase.Length < 10)
        {
            message = "New password must be at least 10 characters.";
            return;
        }

        if (string.IsNullOrWhiteSpace(form.ContentToken))
        {
            message = "Content write token is required to save the new vault.";
            return;
        }

        saving = true;
        message = "";

        try
        {
            await Js.InvokeVoidAsync("window.localStorage.setItem", "jv_content_token", form.ContentToken);
            var result = await Vaults.GenerateResetVaultAsync(form.NewPassphrase);
            if (result.Success)
            {
                success = true;
                message = result.Message + " You can now log in with your new password.";
            }
            else
            {
                message = result.Message;
            }
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private sealed class ResetForm
    {
        public string NewPassphrase { get; set; } = "";
        public string ConfirmPassphrase { get; set; } = "";
        public string ContentToken { get; set; } = "";
    }
}
