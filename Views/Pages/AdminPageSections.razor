@page "/admin/pages/{PageId}/sections"
@inject NavigationManager Nav
@inject PageController Pages

<PageTitle>@pageTitle</PageTitle>

<AdminPageLayout Title="@pageTitle" ToolbarItems="@SectionsToolbar">
    @if (loading)
    {
        <p aria-busy="true">Loading...</p>
    }
    else if (page is null)
    {
        <p>Page not found.</p>
    }
    else if (page.Sections.Count == 0)
    {
        <p>No sections yet.</p>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <p role="alert">@errorMessage</p>
        }
        <div><table>
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Heading</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @for (int idx = 0; idx < page.Sections.Count; idx++)
                {
                    var sec = page.Sections[idx];
                    <tr>
                        <td>@SlugHelper.SectionTypeDisplayName(sec.Type)</td>
                        <td>@sec.Heading</td>
                        <td>
                            <div role="group">
                                <button class="outline" title="Edit" aria-label="Edit" @onclick='() => Nav.NavigateTo($"/admin/pages/{PageId}/sections/edit/{sec.SectionId}")'><i class="site-icon" data-lucide="pencil"></i></button>
                                <button class="outline danger" title="Delete" aria-label="Delete" @onclick='() => Nav.NavigateTo($"/admin/pages/{PageId}/sections/delete/{sec.SectionId}")'><i class="site-icon" data-lucide="trash-2"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</AdminPageLayout>

@code {
    [Parameter] public string PageId { get; set; } = "";

    private string pageTitle => $"{page?.Title ?? "Page"} Sections";

    private RenderFragment SectionsToolbar => __builder =>
    {
        @if (page?.Slug.Equals("blog", StringComparison.OrdinalIgnoreCase) != true)
        {
            <button class="outline" title="Add Section" aria-label="Add Section" @onclick='() => Nav.NavigateTo($"/admin/pages/{PageId}/sections/add")'><i class="site-icon" data-lucide="plus"></i></button>
        }
        <button class="outline secondary" title="Back" aria-label="Back" @onclick='() => Nav.NavigateTo($"/admin/pages/edit/{PageId}")'><i class="site-icon" data-lucide="arrow-left"></i></button>
    };

    private bool loading = true;
    private string errorMessage = "";
    private Page? page;

    protected override async Task OnInitializedAsync()
    {
        page = await Pages.GetPageByIdAsync(PageId);
        loading = false;
    }
}
