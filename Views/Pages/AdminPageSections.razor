@page "/admin/pages/{PageId}/sections"
@inject NavigationManager Nav
@inject PageController Pages

<PageTitle>@pageTitle</PageTitle>

<AdminPageLayout Title="@pageTitle" ToolbarItems="@SectionsToolbar">
    @if (loading)
    {
        <p class="loading-state">Loading...</p>
    }
    else if (page is null)
    {
        <p class="empty-state">Page not found.</p>
    }
    else if (page.Sections.Count == 0)
    {
        <p class="empty-state">No sections yet.</p>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <p role="alert" class="form-alert form-alert-danger">@errorMessage</p>
        }
        <table>
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Heading</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @for (int idx = 0; idx < page.Sections.Count; idx++)
                {
                    var sec = page.Sections[idx];
                    <tr>
                        <td>@SlugHelper.SectionTypeDisplayName(sec.Type)</td>
                        <td>@sec.Heading</td>
                        <td>
                            <button class="outline secondary btn-action" title="Move Up" aria-label="Move Up" disabled="@(savingOrder || idx == 0)" @onclick="() => MoveSectionAsync(idx, -1)"><i class="site-icon" data-lucide="arrow-up"></i></button>
                            <button class="outline secondary btn-action" title="Move Down" aria-label="Move Down" disabled="@(savingOrder || idx == page.Sections.Count - 1)" @onclick="() => MoveSectionAsync(idx, 1)"><i class="site-icon" data-lucide="arrow-down"></i></button>
                            <button class="outline btn-action" title="Edit" aria-label="Edit" @onclick='() => Nav.NavigateTo($"/admin/pages/{PageId}/sections/edit/{sec.SectionId}")'><i class="site-icon" data-lucide="pencil"></i></button>
                            <button class="outline danger btn-action" title="Delete" aria-label="Delete" @onclick='() => Nav.NavigateTo($"/admin/pages/{PageId}/sections/delete/{sec.SectionId}")'><i class="site-icon" data-lucide="trash-2"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</AdminPageLayout>

@code {
    [Parameter] public string PageId { get; set; } = "";

    private string pageTitle => $"{page?.Title ?? "Page"} Sections";

    private RenderFragment SectionsToolbar => __builder =>
    {
        @if (page?.Slug.Equals("blog", StringComparison.OrdinalIgnoreCase) != true)
        {
            <button class="outline" title="Add Section" aria-label="Add Section" @onclick='() => Nav.NavigateTo($"/admin/pages/{PageId}/sections/add")'><i class="site-icon" data-lucide="plus"></i></button>
        }
        <button class="outline secondary btn-action" title="Back" aria-label="Back" @onclick='() => Nav.NavigateTo($"/admin/pages/edit/{PageId}")'><i class="site-icon" data-lucide="arrow-left"></i></button>
    };

    private bool loading = true;
    private bool savingOrder;
    private string errorMessage = "";
    private Page? page;

    protected override async Task OnInitializedAsync()
    {
        page = await Pages.GetPageByIdAsync(PageId);
        loading = false;
    }

    private async Task MoveSectionAsync(int index, int direction)
    {
        if (page is null) return;
        var newIndex = index + direction;
        if (newIndex < 0 || newIndex >= page.Sections.Count) return;

        errorMessage = "";
        savingOrder = true;
        var moved = page.Sections[index];
        page.Sections.RemoveAt(index);
        page.Sections.Insert(newIndex, moved);

        try
        {
            await Pages.UpdatePageAsync(page);
        }
        catch (Exception ex)
        {
            page.Sections.RemoveAt(newIndex);
            page.Sections.Insert(index, moved);
            errorMessage = ex.Message;
        }
        finally
        {
            savingOrder = false;
        }
    }
}
