@page "/blog/{Slug}"
@inject BlogController Blog
@inject RouterController Router
@inject IJSRuntime Js

@if (post is null)
{
    <PageTitle>Post not found — John Vicencio</PageTitle>
    <h1>Post not found</h1>
    <p>This blog post could not be found.</p>
}
else
{
    <PageTitle>@post.Title — John Vicencio</PageTitle>
    <article>
        <header>
            <h1>@post.Title</h1>
            <small><time datetime="@post.PublishedOn.ToString("yyyy-MM-dd")">@post.PublishedOn.ToString("MMMM d, yyyy")</time></small>
        </header>
        @if (!string.IsNullOrWhiteSpace(post.ImageUrl))
        {
            <figure>
                <img src="@post.ImageUrl" alt="@post.Title" />
            </figure>
        }
        <div>@((MarkupString)post.Content)</div>
    </article>

    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "BlogPosting",
      "headline": "@RawTitle(post.Title)",
      "url": "https://johnvicencio.com@Router.BlogPostPath(post.Slug)",
      "datePublished": "@post.PublishedOn.ToString("yyyy-MM-dd")",
      "author": {
        "@@type": "Person",
        "name": "John Vicencio",
        "url": "https://johnvicencio.com"
      }
      @if (!string.IsNullOrWhiteSpace(post.ImageUrl))
      {
          @:,"image": "@(post.ImageUrl.StartsWith("http") ? post.ImageUrl : $"https://johnvicencio.com{post.ImageUrl}")"
      }
    }
    </script>

    @if (prevPost is not null || nextPost is not null)
    {
        <nav aria-label="Post navigation">
            @if (prevPost is not null)
            {
                <a href="@Router.BlogPostPath(prevPost.Slug)" title="@prevPost.Title">
                    <i class="site-icon" data-lucide="arrow-left"></i>
                    <span>@prevPost.Title</span>
                </a>
            }
            else
            {
                <span></span>
            }
            <a href="/blog" role="button" class="outline secondary"><i class="site-icon" data-lucide="list"></i> All Posts</a>
            @if (nextPost is not null)
            {
                <a href="@Router.BlogPostPath(nextPost.Slug)" title="@nextPost.Title">
                    <span>@nextPost.Title</span>
                    <i class="site-icon" data-lucide="arrow-right"></i>
                </a>
            }
            else
            {
                <span></span>
            }
        </nav>
    }
}

@code {
    private static string RawTitle(string title) => title.Replace("\"", "\\\"");

    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private johnvicencio.Models.BlogPost? post;
    private johnvicencio.Models.BlogPost? prevPost;
    private johnvicencio.Models.BlogPost? nextPost;

    protected override async Task OnParametersSetAsync()
    {
        post = await Blog.GetPostAsync(Slug);
        if (post is not null)
        {
            var allPosts = (await Blog.GetPostsAsync())
                .OrderByDescending(p => p.PublishedOn)
                .ToList();
            var idx = allPosts.FindIndex(p => p.Id == post.Id);
            prevPost = idx > 0 ? allPosts[idx - 1] : null;
            nextPost = idx >= 0 && idx < allPosts.Count - 1 ? allPosts[idx + 1] : null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (post is not null)
        {
            await Js.InvokeVoidAsync("setPageMeta", new
            {
                title = $"{post.Title} — John Vicencio",
                description = (post.Summary ?? post.Content ?? "").Length > 160
                    ? (post.Summary ?? post.Content ?? "")[..157] + "..."
                    : (post.Summary ?? post.Content ?? ""),
                image = string.IsNullOrWhiteSpace(post.ImageUrl) ? null : post.ImageUrl.StartsWith("http") ? post.ImageUrl : $"https://johnvicencio.com{post.ImageUrl}"
            });
        }
        if (!firstRender && post is not null)
        {
            // ponytail: scroll intentionally removed — new tab scroll conflict
        }
    }
}
