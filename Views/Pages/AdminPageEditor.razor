@page "/admin/pages/add"
@page "/admin/pages/edit/{PageId}"
@inject VaultSessionService Session
@inject NavigationManager Nav
@inject PageController Pages

<PageTitle>@title</PageTitle>

<div class="login-page" style="width:100%">

    <article style="width:100%;max-width:960px;margin:0 auto">
        <div class="table-toolbar">
            <h2 style="margin:0">@title</h2>
            <div>
                <button class="outline secondary" @onclick='() => Nav.NavigateTo("/admin/pages")'><i class="site-icon" data-lucide="arrow-left"></i>Back</button>
            </div>
        </div>

        @if (loading)
        {
            <p class="pagination-info" style="text-align:center">Loading...</p>
        }
        else
        {
            <div class="page-editor">
                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <p role="alert" class="form-alert form-alert-danger">@message</p>
                }

                @if (isAddMode)
                {
                    <label>Page Type
                        <select @bind="pageKind" @bind:after="OnPageKindChanged">
                            <option value="home">Home Page</option>
                            <option value="content">Content Page</option>
                            <option value="sections">Section Page</option>
                            <option value="blog">Blog Page</option>
                            <option value="contact">Contact Page</option>
                        </select>
                    </label>
                }

                <div class="grid" style="grid-template-columns:1fr 1fr">
                    <label>Page Title
                        <input @bind="editTitle" @oninput="OnTitleChanged" />
                    </label>
                    <label>Slug
                        <input @bind="editSlug" />
                    </label>
                </div>

                <label>Description (SEO)
                    <input @bind="editDescription" />
                </label>

                <label>Keywords (SEO)
                    <textarea @bind="editKeywords" rows="2" placeholder="comma, separated"></textarea>
                </label>

                <hr />

                @if (!isAddMode)
                {
                    @if (IsBlogPage)
                    {
                        <p class="pagination-info">Blog pages use the blog post editor and do not support extra page sections.</p>
                        <button class="outline" @onclick='() => Nav.NavigateTo("/admin/blog")'><i class="site-icon" data-lucide="book-open"></i>Manage Blog</button>
                    }
                    else
                    {
                        <div style="display:flex;gap:0.5rem;margin-bottom:0.5rem">
                            <button class="outline secondary" @onclick='() => Nav.NavigateTo($"/admin/pages/{PageId}/sections")'><i class="site-icon" data-lucide="layers"></i>Manage Sections</button>
                        </div>
                        <p class="pagination-info">@sectionCount section(s) on this page.</p>
                    }
                }

                <hr />
                <button @onclick="SavePage" aria-busy="@saving"><i class="site-icon" data-lucide="save"></i>Save Page</button>
                <button class="outline secondary" @onclick='() => Nav.NavigateTo("/admin/pages")'><i class="site-icon" data-lucide="x"></i>Cancel</button>

            </div>
        }
    </article>

</div>

@code {
    [Parameter]
    public string? PageId { get; set; }

    private bool loading = true;
    private bool saving;
    private bool isAddMode;
    private int sectionCount;
    private string message = "";

    private string editTitle = "";
    private string editSlug = "";
    private string editDescription = "";
    private string editKeywords = "";
    private string pageKind = "content";

    private string title => PageId is null
        ? "Add Page"
        : string.IsNullOrWhiteSpace(editTitle) ? "Edit Page" : $"Edit {editTitle} Page";

    private bool IsBlogPage => editSlug.Equals("blog", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }

        isAddMode = PageId is null;

        if (isAddMode)
        {
            OnPageKindChanged();
        }

        if (!isAddMode)
        {
            var page = await Pages.GetPageByIdAsync(PageId!);
            if (page is not null)
            {
                editTitle = page.Title;
                editSlug = page.Slug;
                editDescription = page.Description;
                editKeywords = page.Keywords;
                sectionCount = page.Sections.Count;
            }
        }

        loading = false;
    }

    private void OnTitleChanged(ChangeEventArgs e)
    {
        editTitle = e.Value?.ToString() ?? "";
        if (isAddMode)
        {
            editSlug = ToSlug(editTitle);
        }
    }

    private void OnPageKindChanged()
    {
        if (!isAddMode) return;

        switch (pageKind)
        {
            case "home":
                editTitle = "Home";
                editSlug = "home";
                editDescription = "Personal site home page.";
                editKeywords = "home, personal, john vicencio";
                break;
            case "blog":
                editTitle = "Blog";
                editSlug = "blog";
                editDescription = "Blog page listing all published posts.";
                editKeywords = "blog, posts, articles";
                break;
            case "contact":
                editTitle = "Contact";
                editSlug = "contact";
                editDescription = "Reach out about projects, collaboration, or research ideas.";
                editKeywords = "contact, email, collaboration";
                break;
            case "content":
                editTitle = string.IsNullOrWhiteSpace(editTitle) ? "Content Page" : editTitle;
                editSlug = string.IsNullOrWhiteSpace(editSlug) ? ToSlug(editTitle) : editSlug;
                break;
            case "sections":
                editTitle = string.IsNullOrWhiteSpace(editTitle) ? "Section Page" : editTitle;
                editSlug = string.IsNullOrWhiteSpace(editSlug) ? ToSlug(editTitle) : editSlug;
                break;
        }
    }

    private async Task SavePage()
    {
        saving = true;
        message = "";
        try
        {
            var existingPage = isAddMode ? null : await Pages.GetPageByIdAsync(PageId!);
            var allPages = await Pages.GetPagesAsync();

            if (isAddMode && allPages.Any(p => p.Slug.Equals(editSlug, StringComparison.OrdinalIgnoreCase)))
            {
                message = $"A page with slug '{editSlug}' already exists.";
                return;
            }

            var page = new Page
            {
                Id = existingPage?.Id ?? Guid.NewGuid().ToString("N")[..12],
                Title = editTitle,
                Slug = editSlug,
                Description = editDescription,
                Keywords = editKeywords,
                SortOrder = existingPage?.SortOrder ?? 0,
                Sections = existingPage?.Sections ?? CreateInitialSections(),
            };

            if (existingPage is not null)
                await Pages.UpdatePageAsync(page);
            else
                await Pages.AddPageAsync(page);

            Nav.NavigateTo("/admin/pages");
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    static string ToSlug(string title)
    {
        if (string.IsNullOrWhiteSpace(title)) return string.Empty;
        var slug = new System.Text.StringBuilder();
        foreach (var c in title.ToLowerInvariant().Trim())
        {
            if (char.IsLetterOrDigit(c))
                slug.Append(c);
            else if (c is ' ' or '-')
                slug.Append('-');
        }
        var result = slug.ToString().Trim('-');
        while (result.Contains("--")) result = result.Replace("--", "-");
        return result;
    }

    private List<PageSection> CreateInitialSections() => pageKind switch
    {
        "home" => [NewSection("content", editTitle, "")],
        "content" => [NewSection("content", editTitle, "")],
        "blog" => [NewSection("content", "Blog", "Read the latest posts and articles.")],
        "contact" => [NewSection("contact", "Get in touch", "Send a note and I will follow up when I can.")],
        _ => [],
    };

    private static PageSection NewSection(string type, string heading, string body) => new()
    {
        SectionId = Guid.NewGuid().ToString("N")[..8],
        Type = type,
        Heading = heading,
        Body = body,
    };
}
